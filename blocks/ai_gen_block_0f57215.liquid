{% doc %}
  @prompt
    Refined version: bordered card grid (up to 6 columns, 3+ rows), logo/image
    centered and fully visible inside each card (contain-fit, adjustable),
    title shown as a plain label below the image (always visible, no overlay),
    whole card links out, one shared color/radius system for the whole block.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collage-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    margin: 0 auto;
    background-color: {{ block.settings.section_bg_color }};
    padding: {{ block.settings.section_padding }}px;
    border-radius: {{ block.settings.section_border_radius }}px;
  }

  .ai-collage__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  /* ---- Card (shared color + radius system) ---- */
  .ai-collage__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    background-color: {{ block.settings.card_bg_color }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    cursor: pointer;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .ai-collage__item-no-link-{{ ai_gen_id }} {
    cursor: default;
  }

  .ai-collage__item-{{ ai_gen_id }}:hover {
    transform: translateY({{ block.settings.hover_lift }}px);
    box-shadow: 0 8px 24px {{ block.settings.card_hover_shadow_color }};
    border-color: {{ block.settings.card_hover_border_color }};
  }

  /* ---- Image area (this is what controls "fit") ---- */
  .ai-collage__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_area_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.image_padding }}px;
    box-sizing: border-box;
  }

  .ai-collage__image-{{ ai_gen_id }} {
    max-width: {{ block.settings.image_max_width_percent }}%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: {{ block.settings.image_fit_mode }};
  }

  .ai-collage__placeholder-{{ ai_gen_id }} {
    width: 60%;
    height: 60%;
    opacity: 0.25;
  }

  /* ---- Optional badge logo (shows on hover, top right) ---- */
  .ai-collage__badge-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.logo_position_top }}px;
    right: {{ block.settings.logo_position_right }}px;
    width: {{ block.settings.logo_size }}px;
    height: {{ block.settings.logo_size }}px;
    border-radius: {{ block.settings.logo_border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.logo_bg_color }};
    padding: {{ block.settings.logo_padding }}px;
    box-shadow: 0 2px 10px {{ block.settings.logo_shadow_color }};
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.25s ease, transform 0.25s ease;
    box-sizing: border-box;
  }

  .ai-collage__item-{{ ai_gen_id }}:hover .ai-collage__badge-{{ ai_gen_id }} {
    opacity: 1;
    transform: scale(1);
  }

  .ai-collage__badge-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ---- Title / description (always visible, plain label) ---- */
  .ai-collage__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    text-transform: {{ block.settings.title_transform }};
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
    margin: {{ block.settings.title_margin_top }}px 0 0;
    line-height: 1.3;
  }

  .ai-collage__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 4px 0 0;
    line-height: 1.5;
  }

  .ai-collage__empty-{{ ai_gen_id }} {
    font-size: 11px;
    color: #999;
    margin-top: 6px;
  }

  @media screen and (max-width: 768px) {
    .ai-collage__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.6 }}px;
    }
    .ai-collage__image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.image_area_height | times: 0.75 }}px;
    }
    .ai-collage__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-collage-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collage__grid-{{ ai_gen_id }}">
    {% for i in (1..18) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign logo_key = 'logo_' | append: i
        assign title_key = 'title_' | append: i
        assign description_key = 'description_' | append: i
        assign link_key = 'link_' | append: i

        assign item_image = block.settings[image_key]
        assign item_logo = block.settings[logo_key]
        assign item_title = block.settings[title_key]
        assign item_description = block.settings[description_key]
        assign item_link = block.settings[link_key]

        assign has_content = false
        if item_image != blank or item_title != blank
          assign has_content = true
        endif
      %}

      {% if has_content %}
        {% if item_link != blank %}
          <a href="{{ item_link }}" class="ai-collage__item-{{ ai_gen_id }}">
        {% else %}
          <div class="ai-collage__item-{{ ai_gen_id }} ai-collage__item-no-link-{{ ai_gen_id }}">
        {% endif %}

          <div class="ai-collage__image-wrapper-{{ ai_gen_id }}">
            {% if item_image %}
              <img
                src="{{ item_image | image_url: width: 400 }}"
                alt="{{ item_title | escape }}"
                loading="lazy"
                width="400"
                height="300"
                class="ai-collage__image-{{ ai_gen_id }}"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'ai-collage__placeholder-' | append: ai_gen_id }}
            {% endif %}

            {% if item_logo %}
              <div class="ai-collage__badge-{{ ai_gen_id }}">
                <img
                  src="{{ item_logo | image_url: width: 200 }}"
                  alt="{{ item_title | escape }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              </div>
            {% endif %}
          </div>

          {% if item_title != blank %}
            <p class="ai-collage__title-{{ ai_gen_id }}">{{ item_title }}</p>
          {% endif %}

          {% if item_description != blank %}
            <p class="ai-collage__description-{{ ai_gen_id }}">{{ item_description }}</p>
          {% endif %}

          {% if item_image == blank %}
            <span class="ai-collage__empty-{{ ai_gen_id }}">Add image {{ i }}</span>
          {% endif %}

        {% if item_link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
</div>

