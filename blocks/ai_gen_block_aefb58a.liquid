{% doc %}
  @prompt
    create a section in which table is created but in single row with divider being short and 0.5 pexel then in that i can attach a logo on the left corner with those settings and then also title and description with color control as well like this and there  is should be margin contorl as well so it looks good, what i have told uo that you can make the logo inside the section and then create 1 row with 4 max coloms with adjustable inside it and there should be no gaps inbetween them and logo inside of all the sections of the table
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-table-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Single layer, no overflow:hidden. The container has generous
     padding around the row, so cells never reach the rounded corners —
     nothing needs clipping. overflow:hidden + border-radius on a large
     flex box is what was causing the black corner artifact (a known
     Chrome GPU-compositing rendering bug), so we simply don't use it. */
  .ai-table-outer-{{ ai_gen_id }} {
    width: 100%;
    box-sizing: border-box;
    background-color: {{ block.settings.container_bg_color }};
    border-radius: {{ block.settings.container_border_radius }}px;
    {% if block.settings.container_border_enabled %}
      border: {{ block.settings.container_border_width }}px solid {{ block.settings.container_border_color }};
    {% endif %}
    padding: {{ block.settings.container_padding_vertical }}px {{ block.settings.container_padding_horizontal }}px;
  }

  .ai-table-row-{{ ai_gen_id }} {
    display: flex;
    width: 100%;
  }

  .ai-table-cell-{{ ai_gen_id }} {
    flex: 1 1 0;
    min-width: 0;
    padding: {{ block.settings.cell_padding_vertical }}px {{ block.settings.cell_padding_horizontal }}px;
    border-right: {{ block.settings.divider_width }}px solid {{ block.settings.divider_color }};
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.content_alignment }};
    text-align: {% if block.settings.content_alignment == 'flex-start' %}left{% elsif block.settings.content_alignment == 'flex-end' %}right{% else %}center{% endif %};
  }

  .ai-table-cell-{{ ai_gen_id }}:first-child {
    padding-left: 0;
  }

  .ai-table-cell-{{ ai_gen_id }}:last-child {
    border-right: none;
    padding-right: 0;
  }

  /* Logo — small mark, sits at the top of the cell (top-left once
     content_alignment is left, which is now the default). */
  .ai-table-logo-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.logo_spacing }}px;
  }

  .ai-table-logo-{{ ai_gen_id }} img {
    width: {{ block.settings.logo_width }}px;
    height: auto;
    display: block;
  }

  .ai-table-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: {{ block.settings.logo_width | times: 0.6 }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-table-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-table-title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    line-height: 1.3;
  }

  .ai-table-description-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-table-section-{{ ai_gen_id }} {
      margin-top: {{ block.settings.margin_top_mobile }}px;
      margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
    }

    .ai-table-outer-{{ ai_gen_id }} {
      border-radius: {{ block.settings.container_border_radius_mobile }}px;
      padding: {{ block.settings.container_padding_vertical_mobile }}px {{ block.settings.container_padding_horizontal_mobile }}px;
    }

    .ai-table-row-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-table-cell-{{ ai_gen_id }} {
      border-right: none;
      border-bottom: {{ block.settings.divider_width }}px solid {{ block.settings.divider_color }};
      padding: {{ block.settings.cell_padding_vertical_mobile }}px {{ block.settings.cell_padding_horizontal_mobile }}px;
    }

    .ai-table-cell-{{ ai_gen_id }}:first-child {
      padding-top: 0;
    }

    .ai-table-cell-{{ ai_gen_id }}:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .ai-table-logo-{{ ai_gen_id }} {
      margin-bottom: {{ block.settings.logo_spacing_mobile }}px;
    }

    .ai-table-logo-{{ ai_gen_id }} img {
      width: {{ block.settings.logo_width_mobile }}px;
    }

    .ai-table-logo-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width_mobile }}px;
      height: {{ block.settings.logo_width_mobile | times: 0.6 }}px;
    }

    .ai-table-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size_mobile }}px;
      margin-bottom: {{ block.settings.title_spacing_mobile }}px;
    }

    .ai-table-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_font_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-table-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-table-outer-{{ ai_gen_id }}">
    <div class="ai-table-row-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign column_enabled_key = 'column_' | append: i | append: '_enabled'
          assign logo_key = 'column_' | append: i | append: '_logo'
          assign title_key = 'column_' | append: i | append: '_title'
          assign description_key = 'column_' | append: i | append: '_description'

          assign column_enabled = block.settings[column_enabled_key]
          assign logo = block.settings[logo_key]
          assign title = block.settings[title_key]
          assign description = block.settings[description_key]
        %}

        {% if column_enabled %}
          <div class="ai-table-cell-{{ ai_gen_id }}">
            <div class="ai-table-logo-{{ ai_gen_id }}">
              {% if logo %}
                <img
                  src="{{ logo | image_url: width: 400 }}"
                  alt="{{ logo.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.logo_width }}"
                  height="auto"
                >
              {% else %}
                <div class="ai-table-logo-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            {% if title != blank %}
              <h3 class="ai-table-title-{{ ai_gen_id }}">{{ title }}</h3>
            {% endif %}
            {% if description != blank %}
              <div class="ai-table-description-{{ ai_gen_id }}">{{ description }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

