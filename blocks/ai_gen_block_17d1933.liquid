{% doc %}
  @prompt
    cna you create a category section that take 3-8 sections that take the image and then also take the logo and then also with title and alos the descitiption and with boarder settings and title settings and descritpion settings and logo settings and also the hover settings of all settings with the link take product link which the settings will be redirected when clicked on
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-section-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-category-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-category-item-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.item_bg_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    transition: all {{ block.settings.hover_transition_speed }}s ease;
    text-decoration: none;
    cursor: pointer;
  }

  .ai-category-item-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.item_hover_bg_color }};
    border-color: {{ block.settings.border_hover_color }};
    transform: translateY({{ block.settings.hover_lift }}px);
    box-shadow: {{ block.settings.hover_shadow_x }}px {{ block.settings.hover_shadow_y }}px {{ block.settings.hover_shadow_blur }}px {{ block.settings.hover_shadow_color }};
  }

  .ai-category-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-category-image-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    object-fit: cover;
    transition: transform {{ block.settings.hover_transition_speed }}s ease, opacity {{ block.settings.hover_transition_speed }}s ease;
  }

  .ai-category-item-{{ ai_gen_id }}:hover .ai-category-image-{{ ai_gen_id }} {
    transform: scale({{ block.settings.image_hover_scale }});
    opacity: {{ block.settings.image_hover_opacity }};
  }

  .ai-category-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-category-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  .ai-category-logo-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.logo_position_top }}%;
    left: {{ block.settings.logo_position_left }}%;
    transform: translate(-50%, -50%);
    z-index: 2;
    transition: all {{ block.settings.hover_transition_speed }}s ease;
  }

  .ai-category-logo-{{ ai_gen_id }} {
    width: {{ block.settings.logo_size }}px;
    height: {{ block.settings.logo_size }}px;
    object-fit: contain;
    background-color: {{ block.settings.logo_bg_color }};
    border-radius: {{ block.settings.logo_border_radius }}px;
    padding: {{ block.settings.logo_padding }}px;
    border: {{ block.settings.logo_border_width }}px solid {{ block.settings.logo_border_color }};
    transition: all {{ block.settings.hover_transition_speed }}s ease;
  }

  .ai-category-item-{{ ai_gen_id }}:hover .ai-category-logo-{{ ai_gen_id }} {
    background-color: {{ block.settings.logo_hover_bg_color }};
    border-color: {{ block.settings.logo_hover_border_color }};
    transform: scale({{ block.settings.logo_hover_scale }});
  }

  .ai-category-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-category-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.3;
    transition: color {{ block.settings.hover_transition_speed }}s ease;
  }

  .ai-category-item-{{ ai_gen_id }}:hover .ai-category-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_hover_color }};
  }

  .ai-category-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
    font-weight: {{ block.settings.description_font.weight }};
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
    margin: 0;
    transition: color {{ block.settings.hover_transition_speed }}s ease;
  }

  .ai-category-item-{{ ai_gen_id }}:hover .ai-category-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_hover_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-category-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-category-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap_mobile }}px;
    }

    .ai-category-image-{{ ai_gen_id }},
    .ai-category-image-placeholder-{{ ai_gen_id }} {
      height: {{ block.settings.image_height_mobile }}px;
    }

    .ai-category-logo-{{ ai_gen_id }} {
      width: {{ block.settings.logo_size_mobile }}px;
      height: {{ block.settings.logo_size_mobile }}px;
    }

    .ai-category-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size_mobile }}px;
    }

    .ai-category-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_font_size_mobile }}px;
    }

    .ai-category-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding_mobile }}px;
    }
  }
{% endstyle %}

<category-section-{{ ai_gen_id }} class="ai-category-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-grid-{{ ai_gen_id }}">
    {% for i in (1..8) %}
      {% liquid
        assign category_enabled_key = 'category_' | append: i | append: '_enabled'
        assign category_image_key = 'category_' | append: i | append: '_image'
        assign category_logo_key = 'category_' | append: i | append: '_logo'
        assign category_title_key = 'category_' | append: i | append: '_title'
        assign category_description_key = 'category_' | append: i | append: '_description'
        assign category_link_key = 'category_' | append: i | append: '_link'

        assign category_enabled = block.settings[category_enabled_key]
        assign category_image = block.settings[category_image_key]
        assign category_logo = block.settings[category_logo_key]
        assign category_title = block.settings[category_title_key]
        assign category_description = block.settings[category_description_key]
        assign category_link = block.settings[category_link_key]
      %}

      {% if category_enabled %}
        <a
          href="{{ category_link }}"
          class="ai-category-item-{{ ai_gen_id }}"
          aria-label="{{ category_title | escape }}"
        >
          <div class="ai-category-image-wrapper-{{ ai_gen_id }}">
            {% if category_image %}
              <img
                src="{{ category_image | image_url: width: 800 }}"
                alt="{{ category_image.alt | default: category_title | escape }}"
                loading="lazy"
                width="800"
                height="{{ block.settings.image_height }}"
                class="ai-category-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-category-image-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if category_logo %}
              <div class="ai-category-logo-wrapper-{{ ai_gen_id }}">
                <img
                  src="{{ category_logo | image_url: width: 200 }}"
                  alt="{{ category_title | escape }} logo"
                  loading="lazy"
                  width="{{ block.settings.logo_size }}"
                  height="{{ block.settings.logo_size }}"
                  class="ai-category-logo-{{ ai_gen_id }}"
                >
              </div>
            {% endif %}
          </div>

          <div class="ai-category-content-{{ ai_gen_id }}">
            {% if category_title != blank %}
              <h3 class="ai-category-title-{{ ai_gen_id }}">{{ category_title }}</h3>
            {% endif %}

            {% if category_description != blank %}
              <p class="ai-category-description-{{ ai_gen_id }}">{{ category_description }}</p>
            {% endif %}
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</category-section-{{ ai_gen_id }}>

<script>
  (function() {
    class CategorySection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.categoryItems = this.querySelectorAll('.ai-category-item-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.categoryItems.forEach((item) => {
          item.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              item.click();
            }
          });
        });
      }
    }

    customElements.define('category-section-{{ ai_gen_id }}', CategorySection{{ ai_gen_id }});
  })();
</script>

