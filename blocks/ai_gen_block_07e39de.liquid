{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-showcase-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    background-color: {{ block.settings.section_background }};
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-category-showcase__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-category-showcase__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px 0;
  }

  .ai-category-showcase__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
  }

  .ai-category-showcase__container-{{ ai_gen_id }} {
    display: grid;
    {% if block.settings.show_featured %}
      {% if block.settings.layout_style == 'featured_left' %}
        grid-template-columns: {{ block.settings.featured_width }}% 1fr;
      {% elsif block.settings.layout_style == 'featured_right' %}
        grid-template-columns: 1fr {{ block.settings.featured_width }}%;
      {% elsif block.settings.layout_style == 'featured_top' %}
        grid-template-columns: 1fr;
      {% else %}
        grid-template-columns: 1fr;
      {% endif %}
    {% else %}
      grid-template-columns: 1fr;
    {% endif %}
    gap: {{ block.settings.grid_gap }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-category-showcase__featured-{{ ai_gen_id }} {
    {% if block.settings.layout_style == 'featured_left' or block.settings.layout_style == 'featured_right' %}
      grid-row: span 1;
    {% endif %}
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    cursor: pointer;
    background-color: {{ block.settings.card_background }};
  }

  .ai-category-showcase__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    {% if block.settings.layout_style == 'featured_right' %}
      order: -1;
    {% endif %}
  }

  .ai-category-showcase__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    cursor: pointer;
    aspect-ratio: {{ block.settings.small_aspect_ratio }};
    background-color: {{ block.settings.card_background }};
  }

  .ai-category-showcase__featured-{{ ai_gen_id }} .ai-category-showcase__image-wrapper-{{ ai_gen_id }} {
    height: 100%;
    aspect-ratio: {{ block.settings.featured_aspect_ratio }};
  }

  .ai-category-showcase__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .ai-category-showcase__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform {{ block.settings.hover_duration }}s ease, filter {{ block.settings.hover_duration }}s ease;
  }

  .ai-category-showcase__item-{{ ai_gen_id }}:hover .ai-category-showcase__image-{{ ai_gen_id }},
  .ai-category-showcase__featured-{{ ai_gen_id }}:hover .ai-category-showcase__image-{{ ai_gen_id }} {
    transform: scale({{ block.settings.hover_scale }});
    filter: brightness({{ block.settings.hover_brightness }});
  }

  .ai-category-showcase__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 100%
    );
    display: flex;
    align-items: flex-end;
    justify-content: {{ block.settings.content_horizontal_position }};
    padding: {{ block.settings.content_padding }}px;
    transition: background {{ block.settings.hover_duration }}s ease;
  }

  .ai-category-showcase__item-{{ ai_gen_id }}:hover .ai-category-showcase__overlay-{{ ai_gen_id }},
  .ai-category-showcase__featured-{{ ai_gen_id }}:hover .ai-category-showcase__overlay-{{ ai_gen_id }} {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, {{ block.settings.hover_overlay_opacity }}) 100%
    );
  }

  .ai-category-showcase__content-{{ ai_gen_id }} {
    width: 100%;
    text-align: {{ block.settings.text_alignment }};
    transition: transform {{ block.settings.hover_duration }}s ease;
  }

  .ai-category-showcase__item-{{ ai_gen_id }}:hover .ai-category-showcase__content-{{ ai_gen_id }},
  .ai-category-showcase__featured-{{ ai_gen_id }}:hover .ai-category-showcase__content-{{ ai_gen_id }} {
    transform: translateY(-{{ block.settings.content_slide_up }}px);
  }

  .ai-category-showcase__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
  }

  .ai-category-showcase__featured-{{ ai_gen_id }} .ai-category-showcase__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.featured_title_size }}px;
  }

  .ai-category-showcase__description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 0 0 {{ block.settings.button_spacing }}px 0;
    opacity: {{ block.settings.description_opacity }};
  }

  .ai-category-showcase__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    opacity: 0;
    transition: all {{ block.settings.hover_duration }}s ease;
    pointer-events: none;
  }

  .ai-category-showcase__item-{{ ai_gen_id }}:hover .ai-category-showcase__button-{{ ai_gen_id }},
  .ai-category-showcase__featured-{{ ai_gen_id }}:hover .ai-category-showcase__button-{{ ai_gen_id }} {
    opacity: 1;
    pointer-events: auto;
  }

  .ai-category-showcase__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-category-showcase__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-category-showcase__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 768px) {
    .ai-category-showcase-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_section_padding_top }}px {{ block.settings.mobile_section_padding_horizontal }}px {{ block.settings.mobile_section_padding_bottom }}px;
    }

    .ai-category-showcase__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-category-showcase__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subheading_size }}px;
    }

    .ai-category-showcase__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-category-showcase__featured-{{ ai_gen_id }} {
      grid-row: span 1;
    }

    .ai-category-showcase__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.mobile_gap }}px;
      order: 0;
    }

    .ai-category-showcase__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .ai-category-showcase__featured-{{ ai_gen_id }} .ai-category-showcase__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_featured_title_size }}px;
    }

    .ai-category-showcase__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_description_size }}px;
    }

    .ai-category-showcase__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_button_font_size }}px;
      padding: {{ block.settings.mobile_button_padding_vertical }}px {{ block.settings.mobile_button_padding_horizontal }}px;
    }

    .ai-category-showcase__item-{{ ai_gen_id }}:hover .ai-category-showcase__content-{{ ai_gen_id }},
    .ai-category-showcase__featured-{{ ai_gen_id }}:hover .ai-category-showcase__content-{{ ai_gen_id }} {
      transform: translateY(-{{ block.settings.mobile_content_slide_up }}px);
    }
  }
{% endstyle %}

<category-showcase-{{ ai_gen_id }}
  class="ai-category-showcase-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.show_header %}
    <div class="ai-category-showcase__header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-category-showcase__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <p class="ai-category-showcase__subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-category-showcase__container-{{ ai_gen_id }}">
    {% if block.settings.show_featured %}
      <a
        href="{{ block.settings.featured_link }}"
        class="ai-category-showcase__featured-{{ ai_gen_id }}"
      >
        <div class="ai-category-showcase__image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.featured_image %}
            <img
              src="{{ block.settings.featured_image | image_url: width: 1200 }}"
              alt="{{ block.settings.featured_title | escape }}"
              class="ai-category-showcase__image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.featured_image.width }}"
              height="{{ block.settings.featured_image.height }}"
            >
          {% else %}
            <div class="ai-category-showcase__placeholder-{{ ai_gen_id }}">
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-category-showcase__overlay-{{ ai_gen_id }}">
          <div class="ai-category-showcase__content-{{ ai_gen_id }}">
            {% if block.settings.featured_title != blank %}
              <h3 class="ai-category-showcase__title-{{ ai_gen_id }}">
                {{ block.settings.featured_title }}
              </h3>
            {% endif %}
            {% if block.settings.show_description and block.settings.featured_description != blank %}
              <p class="ai-category-showcase__description-{{ ai_gen_id }}">
                {{ block.settings.featured_description }}
              </p>
            {% endif %}
            {% if block.settings.show_button and block.settings.button_text != blank %}
              <span class="ai-category-showcase__button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </span>
            {% endif %}
          </div>
        </div>
      </a>
    {% endif %}

    <div class="ai-category-showcase__grid-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% if i <= block.settings.categories_count %}
          {% liquid
            assign image_key = 'category_' | append: i | append: '_image'
            assign title_key = 'category_' | append: i | append: '_title'
            assign description_key = 'category_' | append: i | append: '_description'
            assign link_key = 'category_' | append: i | append: '_link'

            assign category_image = block.settings[image_key]
            assign category_title = block.settings[title_key]
            assign category_description = block.settings[description_key]
            assign category_link = block.settings[link_key]
          %}

          <a
            href="{{ category_link }}"
            class="ai-category-showcase__item-{{ ai_gen_id }}"
          >
            <div class="ai-category-showcase__image-wrapper-{{ ai_gen_id }}">
              {% if category_image %}
                <img
                  src="{{ category_image | image_url: width: 800 }}"
                  alt="{{ category_title | escape }}"
                  class="ai-category-showcase__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ category_image.width }}"
                  height="{{ category_image.height }}"
                >
              {% else %}
                <div class="ai-category-showcase__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-category-showcase__overlay-{{ ai_gen_id }}">
              <div class="ai-category-showcase__content-{{ ai_gen_id }}">
                {% if category_title != blank %}
                  <h3 class="ai-category-showcase__title-{{ ai_gen_id }}">
                    {{ category_title }}
                  </h3>
                {% endif %}
                {% if block.settings.show_description and category_description != blank %}
                  <p class="ai-category-showcase__description-{{ ai_gen_id }}">
                    {{ category_description }}
                  </p>
                {% endif %}
                {% if block.settings.show_button and block.settings.button_text != blank %}
                  <span class="ai-category-showcase__button-{{ ai_gen_id }}">
                    {{ block.settings.button_text }}
                  </span>
                {% endif %}
              </div>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</category-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class CategoryShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-category-showcase__item-{{ ai_gen_id }}, .ai-category-showcase__featured-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.items.forEach((item) => {
          item.setAttribute('role', 'link');
          item.setAttribute('tabindex', '0');

          item.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              item.click();
            }
          });
        });
      }
    }

    customElements.define('category-showcase-{{ ai_gen_id }}', CategoryShowcase{{ ai_gen_id }});
  })();
</script>

