{% doc %}
  @prompt
    create a service section that is like cards with max of 4 cards at a time in a single layout and then colom can be created and then padding can be added in between those two and then there should be a title and with all the fucntionalithy and inside these card title with description and subtitle added in them with backgound control and the alos allow logo on the top left right corner can you make that aslo add the color and everything in this section 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-service-cards-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.section_bg_color }};
  }

  .ai-service-cards-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-service-cards-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.title_alignment }};
    margin-bottom: {{ block.settings.title_spacing }}px;
  }

  .ai-service-cards-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    font-weight: 700;
  }

  .ai-service-cards-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_font_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 10px 0 0;
  }

  .ai-service-cards-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.card_spacing }}px;
  }

  .ai-service-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: {{ block.settings.card_content_alignment }};
    transition: all 0.3s ease;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    position: relative;
  }

  .ai-service-card-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.card_hover_bg_color }};
    border-color: {{ block.settings.card_hover_border_color }};
    transform: translateY({{ block.settings.card_hover_lift }}px);
    box-shadow: {{ block.settings.card_hover_shadow_x }}px {{ block.settings.card_hover_shadow_y }}px {{ block.settings.card_hover_shadow_blur }}px {{ block.settings.card_hover_shadow_color }};
  }

  .ai-service-card-logo-{{ ai_gen_id }} {
    position: absolute;
    {% if block.settings.logo_position == 'top-left' %}
      top: {{ block.settings.card_padding }}px;
      left: {{ block.settings.card_padding }}px;
    {% elsif block.settings.logo_position == 'top-right' %}
      top: {{ block.settings.card_padding }}px;
      right: {{ block.settings.card_padding }}px;
    {% elsif block.settings.logo_position == 'bottom-left' %}
      bottom: {{ block.settings.card_padding }}px;
      left: {{ block.settings.card_padding }}px;
    {% elsif block.settings.logo_position == 'bottom-right' %}
      bottom: {{ block.settings.card_padding }}px;
      right: {{ block.settings.card_padding }}px;
    {% endif %}
    width: {{ block.settings.logo_size }}px;
    height: {{ block.settings.logo_size }}px;
    opacity: {{ block.settings.logo_opacity }};
  }

  .ai-service-card-logo-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-service-card-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_bg_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    padding: {{ block.settings.icon_padding }}px;
  }

  .ai-service-card-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-service-card-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.icon_placeholder_color }};
    border-radius: 4px;
  }

  .ai-service-card-icon-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  .ai-service-card-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
  }

  .ai-service-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_font_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 {{ block.settings.card_title_spacing }}px;
    font-weight: 600;
  }

  .ai-service-card-{{ ai_gen_id }}:hover .ai-service-card-title-{{ ai_gen_id }} {
    color: {{ block.settings.card_title_hover_color }};
  }

  .ai-service-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_font_size }}px;
    color: {{ block.settings.card_description_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-service-card-{{ ai_gen_id }}:hover .ai-service-card-description-{{ ai_gen_id }} {
    color: {{ block.settings.card_description_hover_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-service-cards-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-service-cards-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.8 }}px;
    }

    .ai-service-cards-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_font_size | times: 0.9 }}px;
    }

    .ai-service-cards-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.card_spacing_mobile }}px;
    }

    .ai-service-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding_mobile }}px;
    }

    .ai-service-card-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-service-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_title_font_size | times: 0.9 }}px;
    }

    .ai-service-card-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_description_font_size | times: 0.9 }}px;
    }

    .ai-service-card-logo-{{ ai_gen_id }} {
      width: {{ block.settings.logo_size | times: 0.7 }}px;
      height: {{ block.settings.logo_size | times: 0.7 }}px;
    }
  }
{% endstyle %}

<service-cards-{{ ai_gen_id }} class="ai-service-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-service-cards-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank or block.settings.section_subtitle != blank %}
      <div class="ai-service-cards-header-{{ ai_gen_id }}">
        {% if block.settings.section_title != blank %}
          <h2 class="ai-service-cards-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% endif %}
        {% if block.settings.section_subtitle != blank %}
          <div class="ai-service-cards-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-service-cards-grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign card_enabled_key = 'card_' | append: i | append: '_enabled'
          assign card_icon_key = 'card_' | append: i | append: '_icon'
          assign card_title_key = 'card_' | append: i | append: '_title'
          assign card_description_key = 'card_' | append: i | append: '_description'
          assign card_logo_key = 'card_' | append: i | append: '_logo'

          assign card_enabled = block.settings[card_enabled_key]
          assign card_icon = block.settings[card_icon_key]
          assign card_title = block.settings[card_title_key]
          assign card_description = block.settings[card_description_key]
          assign card_logo = block.settings[card_logo_key]
        %}

        {% if card_enabled %}
          <div class="ai-service-card-{{ ai_gen_id }}">
            {% if card_logo != blank and block.settings.show_logo %}
              <div class="ai-service-card-logo-{{ ai_gen_id }}">
                <img
                  src="{{ card_logo | image_url: width: 200 }}"
                  alt="{{ card_title | escape }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              </div>
            {% endif %}

            <div class="ai-service-card-content-{{ ai_gen_id }}">
              {% if block.settings.show_icon %}
                <div class="ai-service-card-icon-{{ ai_gen_id }}">
                  {% if card_icon != blank %}
                    <img
                      src="{{ card_icon | image_url: width: 150 }}"
                      alt="{{ card_title | escape }}"
                      loading="lazy"
                      width="150"
                      height="150"
                    >
                  {% else %}
                    <div class="ai-service-card-icon-placeholder-{{ ai_gen_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
              {% endif %}

              {% if card_title != blank %}
                <h3 class="ai-service-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
              {% endif %}

              {% if card_description != blank %}
                <div class="ai-service-card-description-{{ ai_gen_id }}">{{ card_description }}</div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</service-cards-{{ ai_gen_id }}>

<script>
  (function() {
    class ServiceCards{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initCards();
      }

      initCards() {
        const cards = this.querySelectorAll('.ai-service-card-{{ ai_gen_id }}');
        
        cards.forEach((card) => {
          card.addEventListener('mouseenter', function() {
            this.style.transition = 'all 0.3s ease';
          });

          card.addEventListener('mouseleave', function() {
            this.style.transition = 'all 0.3s ease';
          });
        });
      }
    }

    customElements.define('service-cards-{{ ai_gen_id }}', ServiceCards{{ ai_gen_id }});
  })();
</script>

