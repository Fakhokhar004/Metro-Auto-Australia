<!doctype html>
<!--[if IE 9]> <html class="ie9 no-js supports-no-cookies" lang="{{ shop.locale }}"> <![endif]-->
<!-- [if (gt IE 9)|!(IE)]><! -->
<html class="no-js supports-no-cookies" lang="{{ shop.locale }}">
<!-- <![endif] -->
  <head>
    <!-- Basic and Helper page needs -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="shortcut icon" href="{{ settings.favicon | img_url: '32x32' }}" type="image/png">
    {%- endif -%}

    <!-- Title and description -->
    {% capture seo_title %}
      {{ page_title }}
      {% if current_tags %}
        {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
      {% endif %}
      {% if current_page != 1 %}
        &ndash; {{ 'general.meta.page' | t: page: current_page }}
      {% endif %}
      {% unless page_title contains shop.name %}
        &ndash; {{ shop.name }}
      {% endunless %}
    {% endcapture %}
    <title>{{ seo_title }}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <!-- Helpers -->
    {%- render 'social-meta-tags', product: product, article: article -%}

    <!-- CSS -->
    {{ 'timber.scss.css' | asset_url | stylesheet_tag }}
    {{ 'custom-draft.css' | asset_url | stylesheet_tag }}
    {{ 'Deal_Collection_custom.css' | asset_url | stylesheet_tag }}
    {%- render 'header-css', content_for_layout: content_for_layout -%}

    <!-- Header hook for plugins -->
    {{ content_for_header }}
    {% render 'oldIE-js' %}

    <!-- JS -->
    {%- render 'header-js', content_for_layout: content_for_layout -%}

    {% if template contains 'customers' %}
      {{ 'shopify_common.js' | shopify_asset_url | script_tag }}
    {% endif %}
    {{ 'custom_breadcrums.css' | asset_url | stylesheet_tag }}

    {%- comment -%} Metro Auto header and footer (also used by layout/metro.liquid). Loaded last so they win over the old theme CSS. {%- endcomment -%}
    {%- render 'ma-head' -%}
  </head>

  <body
    id="{{ page_title | handle }}"
    class="{% if customer %}customer-logged-in {% endif %}template-{{ template.name | handle }}"
  >
    {%- if settings.enable_preloader -%}
      {% render 'preloader' %}
    {%- endif -%}

    {%- if template == 'index' and settings.newsletter_popup_enable -%}
      {% render 'newsletter-popup' %}
    {%- endif -%}

    <div class="wrapper {% if settings.rtl_enable %} rtl__layout{% endif %}">
      {%- if settings.topbar_notification_enable -%}
        {%- if settings.topbar_notification == 'topbar_in_index' and template == 'index' -%}
          {% render 'top-notification-bar' %}
        {%- elsif settings.topbar_notification == 'topbar_in_template' -%}
          {% render 'top-notification-bar' %}
        {%- endif -%}
      {%- endif -%}

      {%- comment -%}
        Old Carwe header and the old fitment bar (snippets/ma-fitment-core) are replaced by the Metro header,
        which has its own garage. Old versions: sections/header-group.json, _backup/layout/theme.liquid.
      {%- endcomment -%}
      <div class="ma-body ma-chrome">
        <a class="ma-skip" href="#MainContent">Skip to content</a>
        {% sections 'ma-header-group' %}
      </div>

      {%- if template != 'index' and settings.breadcrumb_banner_enable -%}
        {% if template == 'collection' %}
          {% if collection.handle == 'all' %}
            {% render 'breadcrumb-banner' %}
            {% section 'breadcrumb' %}
          {% else %}
            {% section 'collection-description' %}
          {%- endif -%}
        {% else %}
          {% render 'breadcrumb-banner' %}
          {% section 'breadcrumb' %}
        {% endif %}
      {%- endif -%}

      <main id="MainContent" tabindex="-1">
        {{ content_for_layout }}
      </main>

      <div class="ma-body ma-chrome">
        {% sections 'ma-footer-group' %}
      </div>

      <!-- Necessary JS -->
      {%- render 'footer-js', content_for_layout: content_for_layout -%}

      {%- if settings.compare_product_enalbe -%}
        {%- render 'compare-popup' -%}
      {%- endif -%}

      <script>
        window.advanceSearch = {
          field_label_1: `{{ 'general.advance_search.field_label_1' | t }}`,
          field_label_2: `{{ 'general.advance_search.field_label_2' | t }}`,
          field_label_3: `{{ 'general.advance_search.field_label_3' | t }}`,
          field_label_4: `{{ 'general.advance_search.field_label_4' | t }}`
        }
      </script>

      {%- if settings.come__back__notification -%}
        <script>
          window.onload = function() {
            var pageTitle = document.title;
            var attentionMessage = '📢 Come Back!';
            var blinkEvent = null;

            document.addEventListener('visibilitychange', function(e) {
              var isPageActive = !document.hidden;
              if (!isPageActive) {
                blink();
              } else {
                document.title = pageTitle;
                clearInterval(blinkEvent);
              }
            });

            function blink() {
              blinkEvent = setInterval(function() {
                if (document.title === attentionMessage) {
                  document.title = pageTitle;
                } else {
                  document.title = attentionMessage;
                }
              }, 500);
            }
          };
        </script>
      {%- endif -%}

      <!-- ▼ SLICK RE-INIT FOR SHOPIFY EDITOR — fixes blank section after save ▼ -->
      <script>
        (function() {
          if (!Shopify.designMode) return;

          function initSlickInSection(sectionEl) {
            if (typeof jQuery === 'undefined' || typeof jQuery.fn.slick === 'undefined') return;

            var sliders = sectionEl.querySelectorAll('.feature-product-slider-active');
            sliders.forEach(function(el) {
              var $el = jQuery(el);

              // Destroy previous instance cleanly
              if ($el.hasClass('slick-initialized')) {
                try { $el.slick('unslick'); } catch(e) {}
              }

              // Read the data-slick config Liquid already put on the element
              var config = {};
              try {
                var raw = el.getAttribute('data-slick');
                if (raw) config = JSON.parse(raw);
              } catch(e) {}

              // Merge with safe defaults
              var defaults = {
                infinite: true,
                slidesToShow: 3,
                slidesToScroll: 1,
                arrows: true,
                rows: 1
              };

              $el.slick(jQuery.extend({}, defaults, config));
            });

            // Re-init countdown timers if present
            var countdowns = sectionEl.querySelectorAll('.theme-product-countdown[data-countdown]');
            countdowns.forEach(function(el) {
              if (typeof initCountdown === 'function') {
                initCountdown(el);
              }
            });
          }

          // Fire on every section:load (triggered after every save in editor)
          document.addEventListener('shopify:section:load', function(e) {
            // Small delay ensures DOM is fully painted before Slick runs
            setTimeout(function() {
              initSlickInSection(e.target);
            }, 100);
          });

          // Also handle block:select (when clicking a block in editor sidebar)
          document.addEventListener('shopify:block:select', function(e) {
            setTimeout(function() {
              var section = e.target.closest('[data-section-id]') || e.target;
              initSlickInSection(section);
            }, 100);
          });

        })();
      </script>
      <!-- ▲ SLICK RE-INIT END ▲ -->

    </div>
  </body>

</html>