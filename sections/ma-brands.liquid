{%- comment -%}
  Metro Auto "Our trusted brands" page. Design reference: _design/metro-auto-design/pages/Brands.dc.html (cards view).
  Brands come from Theme settings → Metro brands (snippets/ma-brand-rows). Each card opens the brand's
  vendor page (/collections/vendors?q=Brand), which sections/ma-collection shows as a brand page.
  Product counts load from sections/ma-brand-meta.
{%- endcomment -%}
{{ 'ma-pages.css' | asset_url | stylesheet_tag }}
{%- capture rows -%}{%- render 'ma-brand-rows' -%}{%- endcapture -%}
{%- assign rows = rows | split: ';;' -%}

<div data-ma-brands>
  <section class="ma-banner">
    <div class="ma-wrap ma-banner__in ma-cats__banner">
      <div class="ma-cats__copy">
        <nav class="ma-banner__crumb" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span aria-current="page">{{ section.settings.title | escape }}</span>
        </nav>
        <h1 class="ma-banner__title">{{ section.settings.title | escape }}</h1>
        {%- if section.settings.text != blank -%}<p class="ma-banner__text">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      <label class="ma-cats__find ma-cats__find--brand">
        {%- render 'ma-icon', name: 'search', size: 18, stroke: '#62666D', width: 2 -%}
        <input type="search" placeholder="Find a brand" aria-label="Find a brand" autocomplete="off" data-ma-brands-input>
      </label>
    </div>
  </section>

  <div class="ma-wrap ma-bpage">
    <div class="ma-bcards">
      {%- comment -%} Brand cards added in the theme editor come first (image or colour), then the list from Theme settings. {%- endcomment -%}
      {%- assign done = ',' -%}
      {%- for block in section.blocks -%}
        {%- assign b_name = block.settings.name | strip -%}
        {%- if b_name == blank -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign b_covers = block.settings.covers
          if b_covers == blank
            assign key = b_name | downcase
            for row in rows
              assign cols = row | split: '|'
              assign k = cols[0] | strip | downcase
              if k == key
                assign b_covers = cols[3] | strip
              endif
            endfor
          endif
          assign b_bg = block.settings.bg
          assign b_fg = block.settings.fg
          if block.settings.use_theme_colour
            assign b_bg = settings.ma_brand_bg
            assign b_fg = settings.ma_brand_fg
          endif
          assign done = done | append: b_name | downcase | append: ','
        -%}
        <div class="ma-bcard-wrap" {{ block.shopify_attributes }}>
          {%- render 'ma-brand-card', name: b_name, covers: b_covers, bg: b_bg, fg: b_fg, image: block.settings.image, image_style: block.settings.image_style -%}
        </div>
      {%- endfor -%}
      {%- if section.blocks.size == 0 or section.settings.show_rest -%}
        {%- for row in rows -%}
          {%- liquid
            assign cols = row | split: '|'
            assign b_name = cols[0] | strip
            if b_name == blank
              continue
            endif
            assign key = ',' | append: b_name | downcase | append: ','
            if done contains key
              continue
            endif
          -%}
          {%- render 'ma-brand-card', name: b_name, covers: cols[3], bg: cols[1], fg: cols[2] -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="ma-empty-box" data-ma-brands-none hidden>
      <h2>No brand called “<span data-ma-brands-q></span>”</h2>
      <p>We stock over 100 brands. Ask us and we'll check if we can get it for you.</p>
      <a class="ma-button ma-button--red" href="{{ section.settings.ask_url | default: '/pages/contact-us' }}">Contact us</a>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-ma-brands]');
    if (!root) return;
    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-ma-bcard]'));
    var input = root.querySelector('[data-ma-brands-input]');
    var none = root.querySelector('[data-ma-brands-none]');
    input.addEventListener('input', function () {
      var f = input.value.trim().toLowerCase(), n = 0;
      cards.forEach(function (c) { var on = !f || c.getAttribute('data-name').indexOf(f) > -1; c.hidden = !on; if (on) n++; });
      none.hidden = n > 0;
      root.querySelectorAll('[data-ma-brands-q]').forEach(function (s) { s.textContent = input.value.trim(); });
    });
    /* product counts */
    cards.forEach(function (c) {
      var v = c.getAttribute('data-vendor');
      if (!v) return;
      var href = c.getAttribute('href');
      fetch(href + (href.indexOf('?') > -1 ? '&' : '?') + 'section_id=ma-brand-meta')
        .then(function (r) { return r.text(); })
        .then(function (html) {
          var el = new DOMParser().parseFromString(html, 'text/html').querySelector('[data-ma-brand-meta]');
          var m = el && JSON.parse(el.textContent);
          if (!m) return;
          c.querySelector('[data-ma-bcard-count]').textContent = m.count ? m.count.toLocaleString('en-AU') + (m.count === 1 ? ' product' : ' products') : 'Range coming soon';
        }).catch(function () {});
    });
  })();
</script>

{% schema %}
{
  "name": "Metro brands",
  "tag": "section",
  "class": "ma-body",
  "settings": [
    { "type": "paragraph", "content": "Add a Brand card block to give a brand its own image or colour. Other brands come from Theme settings → Metro brands." },
    { "type": "text", "id": "title", "label": "Heading", "default": "Our trusted brands" },
    { "type": "textarea", "id": "text", "label": "Banner text", "default": "We buy direct from the makers, so every part carries the manufacturer's warranty. Pick a brand to see its products, prices and stock." },
    { "type": "url", "id": "ask_url", "label": "Contact link", "info": "Defaults to /pages/contact-us" },
    { "type": "checkbox", "id": "show_rest", "label": "Also show brands without a card block", "info": "From Theme settings → Metro brands and the store's vendors.", "default": true }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand card",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand (vendor name)", "info": "Must match the product vendor, e.g. Goss" },
        { "type": "text", "id": "covers", "label": "What it covers", "info": "Empty uses the text from Theme settings → Metro brands." },
        { "type": "image_picker", "id": "image", "label": "Image or logo" },
        { "type": "select", "id": "image_style", "label": "Image style", "default": "logo", "options": [
          { "value": "logo", "label": "Logo on the card colour" },
          { "value": "photo", "label": "Photo filling the card" }
        ] },
        { "type": "checkbox", "id": "use_theme_colour", "label": "Use the brand colour from Theme settings", "default": false },
        { "type": "color", "id": "bg", "label": "Card colour", "default": "#121316" },
        { "type": "color", "id": "fg", "label": "Text colour", "default": "#FFFFFF" }
      ]
    }
  ],
  "presets": [{ "name": "Metro brands" }]
}
{% endschema %}
