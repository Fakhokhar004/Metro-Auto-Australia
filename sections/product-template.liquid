{%- comment -%} ============ WISHLIST BUTTON (added) ============ {%- endcomment -%}
{%- if section.settings.wishlist_enable -%}
{% style %}
  /* ===== Wishlist button (icon only, compact) ===== */
  /* !important is used so the theme's button-row flex stretch and default
     button styles can't override the size/colors you set in the customizer. */
  .theme-wishlist-btn{
    --wl-bg:{{ section.settings.wishlist_bg_color | default: '#e50000' }};
    --wl-hover-bg:{{ section.settings.wishlist_hover_bg_color | default: '#c30000' }};
    --wl-icon:{{ section.settings.wishlist_icon_color | default: '#1f2226' }};
    --wl-hover-icon:{{ section.settings.wishlist_hover_icon_color | default: '#ffffff' }};
    --wl-glow:{{ section.settings.wishlist_glow_color | default: '#ffffff' }};
    --wl-radius:{{ section.settings.wishlist_border_radius | default: 8 }}px;
    --wl-pad-v:{{ section.settings.wishlist_padding_v | default: 18 }}px;
    --wl-pad-h:{{ section.settings.wishlist_padding_h | default: 18 }}px;
    --wl-icon-size:{{ section.settings.wishlist_icon_size | default: 22 }}px;

    display:inline-flex !important;
    align-items:center !important;
    justify-content:center !important;
    /* Fixed square that always matches the Add to Cart button's height —
       do NOT stretch to fill the theme's button row */
    width:56px !important;
    height:56px !important;
    min-width:56px !important;
    max-width:56px !important;
    flex:0 0 auto !important;
    align-self:center !important;
    padding:0 !important;
    margin:0 0 0 12px !important;
    border:0 !important;
    background:var(--wl-bg) !important;
    border-radius:var(--wl-radius) !important;
    cursor:pointer !important;
    line-height:0 !important;
    vertical-align:middle !important;
    box-shadow:10px 25px 80px rgba(150,150,150,.15);
    transition:background .25s ease, transform .15s ease, box-shadow .25s ease;
  }
  .theme-wishlist-btn:hover{
    background:var(--wl-hover-bg) !important;
    transform:translateY(-1px);
  }
  .theme-wishlist-btn:active{ transform:translateY(0); }
  .theme-wishlist-btn:focus{ outline:none !important; }

  .theme-wishlist-btn .wishlist-heart{
    width:var(--wl-icon-size) !important;
    height:var(--wl-icon-size) !important;
    display:inline-flex !important;
    color:var(--wl-icon) !important;
    transition:color .25s ease, filter .25s ease, transform .25s ease;
  }
  .theme-wishlist-btn:hover .wishlist-heart{ color:var(--wl-hover-icon) !important; }

  .theme-wishlist-btn .wishlist-heart svg{ width:100% !important; height:100% !important; display:block !important; }
  .theme-wishlist-btn .wishlist-heart svg path{
    fill:none;
    stroke:currentColor;
    stroke-width:2;
    transition:fill .25s ease, stroke .25s ease;
  }

  /* Saved / glowing state — filled heart in the admin glow color */
  .theme-wishlist-btn.is-wishlisted .wishlist-heart{
    color:var(--wl-glow) !important;
    filter:drop-shadow(0 0 6px var(--wl-glow));
    animation:wishlistPulse .5s ease;
  }
  .theme-wishlist-btn.is-wishlisted:hover .wishlist-heart{ color:var(--wl-glow) !important; }
  .theme-wishlist-btn.is-wishlisted .wishlist-heart svg path{
    fill:var(--wl-glow);
    stroke:var(--wl-glow);
  }
  @keyframes wishlistPulse{
    0%{ transform:scale(1); }
    40%{ transform:scale(1.3); }
    100%{ transform:scale(1); }
  }
{% endstyle %}

<script>
(function(){
  var CONFIG = {
    id: {{ product.id | json }},
    handle: {{ product.handle | json }},
    title: {{ product.title | json }},
    url: {{ product.url | json }},
    price: {{ product.price | money | json }},
    image: {% if product.featured_image %}{{ product.featured_image | image_url: width: 400 | json }}{% else %}""{% endif %}
  };

  var STORAGE_KEY = 'theme_wishlist';

  function getList(){
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; }
    catch(e){ return []; }
  }
  function saveList(list){
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(list)); } catch(e){}
  }
  function indexOf(list, id){
    for (var i = 0; i < list.length; i++){ if (list[i].id === id) return i; }
    return -1;
  }
  function isSaved(id){ return indexOf(getList(), id) > -1; }

  function heartSVG(){
    return '<span class="wishlist-heart"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">'
      + '<path d="M12 21s-7.5-4.9-10-9.2C.5 8.6 2 5 5.5 5 8 5 9.5 6.8 12 9c2.5-2.2 4-4 6.5-4C22 5 23.5 8.6 22 11.8 19.5 16.1 12 21 12 21z"/>'
      + '</svg></span>';
  }

  function buildButton(){
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'theme-wishlist-btn';
    btn.setAttribute('aria-label', 'Add to wishlist');
    btn.setAttribute('title', 'Add to wishlist');
    // Icon only — no text label.
    btn.innerHTML = heartSVG();
    if (isSaved(CONFIG.id)){ btn.classList.add('is-wishlisted'); }
    btn.addEventListener('click', onClick);
    return btn;
  }

  function onClick(e){
    e.preventDefault();
    var btn = e.currentTarget;
    var list = getList();
    var idx = indexOf(list, CONFIG.id);

    if (idx > -1){
      // Already saved -> remove it and turn the glow off.
      list.splice(idx, 1);
      saveList(list);
      btn.classList.remove('is-wishlisted');
    } else {
      // SAVE the product to the wishlist (persists in the browser).
      list.push({
        id: CONFIG.id,
        handle: CONFIG.handle,
        title: CONFIG.title,
        url: CONFIG.url,
        price: CONFIG.price,
        image: CONFIG.image
      });
      saveList(list);
      // Make the heart GLOW in the admin-chosen color.
      btn.classList.add('is-wishlisted');
      // NOTE: no redirect. The product is saved to the browser and will appear
      // on your Wishlist page (the collection section set to "Wishlist" mode).
    }
  }

  function inject(){
    if (document.querySelector('.theme-wishlist-btn')) return true;
    // Common add-to-cart selectors — the first one found is used.
    var selectors = [
      '.single_add_to_cart_button',
      'button[name="add"]',
      '.product-cart-btn',
      '.add_to_cart',
      '.add-to-cart',
      '.btn-cart',
      '#AddToCart',
      '.product-form__submit'
    ];
    var atc = null;
    for (var i = 0; i < selectors.length; i++){
      atc = document.querySelector(selectors[i]);
      if (atc) break;
    }
    if (!atc) return false;

    var btn = buildButton();
    if (atc.parentNode){
      atc.parentNode.insertBefore(btn, atc.nextSibling);
    }
    return true;
  }

  function init(){
    if (inject()) return;
    // Retry a few times in case the add-to-cart button renders after load.
    var tries = 0;
    var timer = setInterval(function(){
      tries++;
      if (inject() || tries > 20){ clearInterval(timer); }
    }, 300);
  }

  if (document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
{%- endif -%}
