<div class="about-img-text-section" id="about-img-text-{{ section.id }}">
  <div class="container">
    <div class="about-img-text-row layout-{{ section.settings.image_position }}">

      <div class="about-img-text-media">
        <div class="about-img-text-image-wrap">
          {%- if section.settings.content_image != blank -%}
            {%- assign widths = '375, 550, 750, 1100, 1500, 1780, 2000' -%}
            {{ section.settings.content_image | image_url: width: 2000 | image_tag:
              widths: widths,
              loading: 'lazy',
              class: 'about-img-text-image',
              alt: section.settings.content_image.alt | default: section.settings.heading
            }}
          {%- else -%}
            <img class="about-img-text-image" src="https://via.placeholder.com/700x520" alt="">
          {%- endif -%}
        </div>

        {%- if section.settings.show_badge and section.settings.badge_number != blank -%}
          <div class="about-img-text-badge">
            <span class="about-img-text-badge-number">{{ section.settings.badge_number }}</span>
            {%- if section.settings.badge_label != blank -%}
              <span class="about-img-text-badge-label">{{ section.settings.badge_label }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="about-img-text-content">

        {%- if section.settings.eyebrow_text != blank -%}
          <p class="about-img-text-eyebrow">{{ section.settings.eyebrow_text }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="about-img-text-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="about-img-text-description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
          <a href="{{ section.settings.link_url }}" class="about-img-text-link">
            {{ section.settings.link_label }}
            <span class="about-img-text-link-arrow" aria-hidden="true">&#8594;</span>
          </a>
        {%- endif -%}

      </div>

    </div>
  </div>
</div>

{%- style -%}
  #about-img-text-{{ section.id }} {
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
    background-color: {{ section.settings.section_bg_color }};
  }

  #about-img-text-{{ section.id }} .about-img-text-row {
    display: flex;
    align-items: center;
    gap: {{ section.settings.column_gap }}px;
    flex-wrap: wrap;
  }

  #about-img-text-{{ section.id }} .about-img-text-row.layout-right {
    flex-direction: row-reverse;
  }

  #about-img-text-{{ section.id }} .about-img-text-media {
    position: relative;
    flex: 1 1 {{ section.settings.image_width }}%;
    min-width: 280px;
  }

  #about-img-text-{{ section.id }} .about-img-text-image-wrap {
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
  }

  #about-img-text-{{ section.id }} .about-img-text-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  #about-img-text-{{ section.id }} .about-img-text-badge {
    position: absolute;
    bottom: -{{ section.settings.badge_offset }}px;
    right: {{ section.settings.badge_offset }}px;
    background-color: {{ section.settings.badge_bg_color }};
    color: {{ section.settings.badge_text_color }};
    width: {{ section.settings.badge_size }}px;
    height: {{ section.settings.badge_size }}px;
    border-radius: {{ section.settings.badge_border_radius }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: 0 8px 20px rgba(0,0,0,0.18);
  }

  #about-img-text-{{ section.id }} .about-img-text-badge-number {
    font-size: {{ section.settings.badge_number_size }}px;
    font-weight: 800;
    line-height: 1.1;
  }

  #about-img-text-{{ section.id }} .about-img-text-badge-label {
    font-size: {{ section.settings.badge_label_size }}px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-top: 4px;
  }

  #about-img-text-{{ section.id }} .about-img-text-content {
    flex: 1 1 {{ section.settings.content_width }}%;
    min-width: 280px;
  }

  #about-img-text-{{ section.id }} .about-img-text-eyebrow {
    color: {{ section.settings.eyebrow_color }};
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 0 0 12px 0;
  }

  #about-img-text-{{ section.id }} .about-img-text-heading {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 20px 0;
  }

  #about-img-text-{{ section.id }} .about-img-text-description {
    color: {{ section.settings.description_color }};
    font-size: {{ section.settings.description_size }}px;
    line-height: 1.7;
  }

  #about-img-text-{{ section.id }} .about-img-text-description p {
    margin: 0 0 18px 0;
  }

  #about-img-text-{{ section.id }} .about-img-text-description p:last-child {
    margin-bottom: 0;
  }

  #about-img-text-{{ section.id }} .about-img-text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    color: {{ section.settings.link_color }};
    font-size: {{ section.settings.link_size }}px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    text-decoration: none;
  }

  #about-img-text-{{ section.id }} .about-img-text-link-arrow {
    transition: transform 0.2s ease;
  }

  #about-img-text-{{ section.id }} .about-img-text-link:hover .about-img-text-link-arrow {
    transform: translateX(4px);
  }

  @media only screen and (max-width: 767px) {
    #about-img-text-{{ section.id }} {
      padding-top: {{ section.settings.section_padding_top_mobile }}px;
      padding-bottom: {{ section.settings.section_padding_bottom_mobile }}px;
    }

    #about-img-text-{{ section.id }} .about-img-text-row,
    #about-img-text-{{ section.id }} .about-img-text-row.layout-right {
      flex-direction: column;
    }

    #about-img-text-{{ section.id }} .about-img-text-media {
      flex-basis: 100%;
    }

    #about-img-text-{{ section.id }} .about-img-text-content {
      flex-basis: 100%;
    }

    #about-img-text-{{ section.id }} .about-img-text-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    #about-img-text-{{ section.id }} .about-img-text-description {
      font-size: {{ section.settings.description_size_mobile }}px;
    }

    #about-img-text-{{ section.id }} .about-img-text-badge {
      width: {{ section.settings.badge_size_mobile }}px;
      height: {{ section.settings.badge_size_mobile }}px;
      right: {{ section.settings.badge_offset_mobile }}px;
      bottom: -{{ section.settings.badge_offset_mobile }}px;
    }
  }
{%- endstyle -%}

