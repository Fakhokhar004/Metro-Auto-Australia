<div class="banner-area single_product_feature" id="section-{{ section.id }}">
  <div class="{% if section.settings.section_width == 'full_width' %}container-fluid {% elsif section.settings.section_width == 'box_width' %}container-fluid section-padding-1{% elsif section.settings.section_width == 'default' %}container default {% endif %}">

    {% if section.settings.section_title != "" or section.settings.section_sub_title != "" %}
    <div class="section-title {{ section.settings.title_align }} pb-60">
      {% if section.settings.section_title != "" %}<h2>{{ section.settings.section_title }}</h2>{% endif %}
      {% if section.settings.section_sub_title != "" %}<p>{{ section.settings.section_sub_title }}</p>{% endif %}
    </div>
    {% endif %}

    <!-- SLIDER LAYOUT -->
    <div class="spf-wrap">

      <!-- LEFT PANEL -->
      {%- if section.settings.content_column_left_enable -%}
      <div class="spf-panel">
        {%- if section.settings.t1_left != "" -%}<p class="spf-sub">{{ section.settings.t1_left }}</p>{%- endif -%}
        {%- if section.settings.t2_left != "" -%}<h2 class="spf-title">{{ section.settings.t2_left }}</h2>{%- endif -%}
        <div class="spf-slides-box" id="spf-L-{{ section.id }}">
          {%- assign li = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == "single_feature_left" -%}
  {%- capture drive_image -%}
  {%- assign left_text = block.settings.feature_text_left | downcase -%}
  {%- assign right_text = block.settings.feature_text_right | downcase -%}
  {%- assign title_check = left_text -%}
  {%- if title_check == blank -%}
    {%- assign title_check = right_text -%}
  {%- endif -%}

  {%- if title_check contains 'brake pads' -%}
    https://cdn.shopify.com/s/files/1/0711/9814/6747/files/Brake_Pads_4ca636f2-bd55-44eb-9ea4-d7475ffef977.jpg?v=1778249168
  {%- elsif title_check contains 'lubricant' -%}
    https://cdn.shopify.com/s/files/1/0711/9814/6747/files/Engine_oif.jpg?v=1778249169
  {%- elsif title_check contains 'air filter' -%}
    https://cdn.shopify.com/s/files/1/0711/9814/6747/files/Air_Filter.jpg?v=1778249169
  {%- elsif title_check contains 'car batteries' -%}
    https://cdn.shopify.com/s/files/1/0711/9814/6747/files/Battary.jpg?v=1778249168
  {%- elsif title_check contains 'headlights' or title_check contains 'led bulbs' -%}
    https://cdn.shopify.com/s/files/1/0711/9814/6747/files/Head_Light.jpg?v=1778249169
  {%- elsif title_check contains 'spark plugs' -%}
    https://cdn.shopify.com/s/files/1/0711/9814/6747/files/spark_Plug.jpg?v=1778249168
  {%- else -%}
    {%- if block.settings.img1_left != blank -%}
      {{ block.settings.img1_left | image_url: '1000x' }}
    {%- else -%}
      https://cdn.shopify.com/s/files/1/0711/9814/6747/files/default_image.jpg?v=123456
    {%- endif -%}
  {%- endif -%}
  {%- endcapture -%}

  <div class="spf-slide{% if li == 0 %} is-active{% endif %}">
    
    <div class="spf-card" style="background: linear-gradient(to top, rgba(0,0,0,0.85), rgba(0,0,0,0.2)), url('{{ drive_image | strip }}') center/cover no-repeat;">
      <div class="spf-icon">
        {%- if block.settings.feature_icon_left != "" -%}
          <i class="{{ block.settings.feature_icon_left }}"></i>
        {%- elsif block.settings.img1_left -%}
          {{ block.settings.img1_left | image_url: '1000x' }}
        {%- endif -%}
      </div>
      <div class="spf-text">
        {%- if block.settings.feature_text_left != "" -%}<h4>{{ block.settings.feature_text_left }}</h4>{%- endif -%}
        {%- if block.settings.feature_des_left != "" -%}<p>{{ block.settings.feature_des_left }}</p>{%- endif -%}
      </div>
    </div>
  </div>
  {%- assign li = li | plus: 1 -%}
  {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="spf-controls">
          <button class="spf-btn" onclick="spfMove('L','{{ section.id }}', -1)">&#8592;</button>
          <div class="spf-dots" id="spf-L-dots-{{ section.id }}"></div>
          <button class="spf-btn" onclick="spfMove('L','{{ section.id }}', 1)">&#8594;</button>
        </div>
        {%- if section.settings.btn1_left != "" -%}
          <a class="spf-cta" href="{{ section.settings.btn1_url_left }}">{{ section.settings.btn1_left }}</a>
        {%- endif -%}
      </div>
      {%- endif -%}

      <!-- CENTER IMAGE -->
      {%- if section.settings.feature_img_enable -%}
      <div class="spf-img-col">
        {%- if section.settings.img1 -%}
          <img src="{{ section.settings.img1 | img_url: "400x" }}" alt="">
        {%- else -%}
          <img src="https://via.placeholder.com/320x400" alt="">
        {%- endif -%}
      </div>
      {%- endif -%}

      <!-- RIGHT PANEL -->
  {%- if section.settings.content_column_right_enable -%}
  <div class="spf-panel">
  {%- if section.settings.t1_right != "" -%}<p class="spf-sub">{{ section.settings.t1_right }}</p>{%- endif -%}
  {%- if section.settings.t2_right != "" -%}<h2 class="spf-title">{{ section.settings.t2_right }}</h2>{%- endif -%}
  <div class="spf-slides-box" id="spf-R-{{ section.id }}">
    {%- assign ri = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == "single_feature_right" -%}
        <div class="spf-slide{% if ri == 0 %} is-active{% endif %}">
          <div class="spf-card">

            {%- comment -%} === IMAGE CAPTURE (uses right‑side text) === {%- endcomment -%}
            {%- capture drive_image -%}
              {%- assign title_check = block.settings.feature_text_right | downcase -%}
              {%- if title_check contains 'brake pads' -%}
                https://cdn.shopify.com/s/files/1/0711/9814/6747/files/Brake_Pads_4ca636f2-bd55-44eb-9ea4-d7475ffef977.jpg?v=1778249168
              {%- elsif title_check contains 'lubricant' -%}
                https://cdn.shopify.com/s/files/1/0711/9814/6747/files/Engine_oif.jpg?v=1778249169
              {%- elsif title_check contains 'air filter' -%}
                https://cdn.shopify.com/s/files/1/0711/9814/6747/files/Air_Filter.jpg?v=1778249169
              {%- elsif title_check contains 'car batteries' -%}
                https://cdn.shopify.com/s/files/1/0711/9814/6747/files/Battary.jpg?v=1778249168
              {%- elsif title_check contains 'headlights' or title_check contains 'led bulbs' -%}
                https://cdn.shopify.com/s/files/1/0711/9814/6747/files/Head_Light.jpg?v=1778249169
              {%- elsif title_check contains 'spark plugs' -%}
                https://cdn.shopify.com/s/files/1/0711/9814/6747/files/spark_Plug.jpg?v=1778249168
              {%- else -%}
                {%- if block.settings.img1_right != blank -%}
                  {{ block.settings.img1_right | img_url: '1000x' }}
                {%- else -%}
                  https://cdn.shopify.com/s/files/1/0711/9814/6747/files/default_image.jpg?v=123456
                {%- endif -%}
              {%- endif -%}
            {%- endcapture -%}

            {%- comment -%} Display the main product image (adjusts to card size via CSS) {%- endcomment -%}
            <div class="spf-main-image">
              <img src="{{ drive_image | strip }}" alt="{{ block.settings.feature_text_right }}">
            </div>

            {%- comment -%} Original icon, text (unchanged) {%- endcomment -%}
            <div class="spf-icon">
              {%- if block.settings.feature_icon_right != "" -%}
