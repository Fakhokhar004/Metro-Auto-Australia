  {%- endif -%}
</div>

  {%- endif -%}
</div> 
</div>
</div>
  <style>
  #section-{{ section.id }},
  #section-{{ section.id }} .banner-area,
  #section-{{ section.id }} > div { background: #ffffff !important; }

  /* Wrap */
  #section-{{ section.id }} {
  background: #ffffff !important;
  position: relative;
  overflow: hidden;
  height: auto;
}

/* Wrap */
#section-{{ section.id }} .spf-wrap {
  display: flex;
  align-items: flex-start;
  gap: 32px;
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
}

  /* Panels */
  #section-{{ section.id }} .spf-panel {
    flex: 1;
    min-width: 0;
  }
  #section-{{ section.id }} .spf-sub {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #999;
    margin: 0 0 4px;
  }
  #section-{{ section.id }} .spf-title {
    font-size: 20px;
    font-weight: 800;
    color: #111;
    margin: 0 0 16px;
    line-height: 1.25;
  }

/* Slides */
#section-{{ section.id }} .spf-slides-box {
  position: relative;
  min-height: 110px;
}
#section-{{ section.id }} .spf-slide {
  display: none;
}
#section-{{ section.id }} .spf-slide.is-active {
  display: block;
  animation: spfIn .3s ease;
}
@keyframes spfIn {
  from { opacity:0; transform:translateY(8px); }
  to   { opacity:1; transform:translateY(0); }
}

/* Card */
#section-{{ section.id }} .spf-card {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 18px;
  border-radius: 12px;
  background: #f7f7f7;
  border: 1.5px solid #eee;
}
#section-{{ section.id }} .spf-icon {
  flex-shrink: 0;
  width: 46px;
  height: 46px;
  background: #111;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}
#section-{{ section.id }} .spf-icon i {
  color: #fff !important;
  font-size: 20px;
}
#section-{{ section.id }} .spf-icon img {
  width: 26px;
  height: 26px;
  object-fit: contain;
  filter: invert(1);
}
#section-{{ section.id }} .spf-text h4 {
  font-size: 15px;
  font-weight: 700;
  color: #111 !important;
  margin: 0 0 6px;
}
#section-{{ section.id }} .spf-text p {
  font-size: 13px;
  color: #666 !important;
  line-height: 1.6;
  margin: 0;
}

/* Controls */
#section-{{ section.id }} .spf-controls {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 14px;
}
#section-{{ section.id }} .spf-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 1.5px solid #ddd;
  background: #fff;
  cursor: pointer;
  font-size: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all .2s;
  flex-shrink: 0;
  color: #111;
  padding: 0;
}
#section-{{ section.id }} .spf-btn:hover {
  background: #111;
  color: #fff;
  border-color: #111;
}
#section-{{ section.id }} .spf-dots {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
}
#section-{{ section.id }} .spf-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #ddd;
  border: none;
  cursor: pointer;
  padding: 0;
  transition: all .2s;
}
#section-{{ section.id }} .spf-dot.is-active {
  background: #d10000;
  transform: scale(1.35);
}

/* CTA */
#section-{{ section.id }} .spf-cta {
  display: inline-block;
  margin-top: 16px;
  padding: 9px 22px;
  background: #d10000;
  color: #fff !important;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  transition: background .2s;
}
#section-{{ section.id }} .spf-cta:hover { background: #a80000; }

/* Center image */
#section-{{ section.id }} .spf-img-col {
  flex: 0 0 auto;
  width: 420px;
}
#section-{{ section.id }} .spf-img-col img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 10px;
}

/* Mobile */
@media (max-width: 767px) {
  #section-{{ section.id }} .spf-wrap {
    flex-direction: column;
    gap: 24px;
  }
  #section-{{ section.id }} .spf-img-col {
    width: 100%;
    order: -1;
  }
  #section-{{ section.id }} .spf-panel {
    width: 100%;
  }
  #section-{{ section.id }} .spf-title { font-size: 17px; }
}
</style>

<script>
(function(){
  function initDots(side, secId) {
    var slides = document.querySelectorAll('#spf-' + side + '-' + secId + ' .spf-slide');
    var wrap = document.getElementById('spf-' + side + '-dots-' + secId);
    if (!wrap || !slides.length) return;
    slides.forEach(function(s, i){
      var d = document.createElement('button');
      d.className = 'spf-dot' + (i===0 ? ' is-active' : '');
      d.setAttribute('aria-label', 'Go to slide ' + (i+1));
      d.addEventListener('click', function(){ spfGoTo(side, secId, i); });
      wrap.appendChild(d);
    });
  }
  document.addEventListener('DOMContentLoaded', function(){
    initDots('L','{{ section.id }}');
    initDots('R','{{ section.id }}');
  });

  window.spfMove = function(side, secId, dir){
  var slides = document.querySelectorAll('#spf-' + side + '-' +secId + ' .spf-slide');

  if (!slides.length) return;

  var cur = 0;

  slides.forEach(function(s, i){
    if(s.classList.contains('is-active')) {
      cur = i;
    }
  });

  spfGoTo(side, secId, (cur + dir + slides.length) % slides.length);
};

  window.spfGoTo = function(side, secId, idx){
    var slides = document.querySelectorAll('#spf-' + side + '-' + secId + ' .spf-slide');
    var dots   = document.querySelectorAll('#spf-' + side + '-dots-' + secId + ' .spf-dot');
    slides.forEach(function(s){ s.classList.remove('is-active'); });
    dots.forEach(function(d){ d.classList.remove('is-active'); });
    if(slides[idx]) slides[idx].classList.add('is-active');
    if(dots[idx])   dots[idx].classList.add('is-active');
  };
})();
</script>

