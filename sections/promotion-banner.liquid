<div class="banner-area countdown_promotion_banner" id="section-{{ section.id }}">
  <div class="{% if section.settings.section_width == 'full_width' %}container-fluid {% elsif section.settings.section_width == 'box_width' %}container-fluid section-padding-1{% elsif section.settings.section_width == 'default' %}container default {% endif %}">
    {% if section.settings.section_title != '' or section.settings.section_sub_title != '' %}
      <div class="section-title {{ section.settings.title_align }} pb-40 {% if settings.section__animation__enable %}scroll-zoom {% endif %}">
        {% if section.settings.section_title != '' %}
          <h2>{{ section.settings.section_title }}</h2>
        {% endif %}

        {% if section.settings.section_sub_title != '' %}
          <p>{{ section.settings.section_sub_title }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="row align-items-center {{ section.settings.content_align }} {{ section.settings.content_position }} {% if settings.section__animation__enable %}scroll-zoom {% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
         
          {%- when 'promoton-img' -%}

              {%- liquid
                assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                assign fetch_priority = 'auto'
                if section.index == 1
                  assign fetch_priority = 'high'
                endif
                assign image_class = 'lazyload-main-image animated responsive-image__image'
                assign lazy_load = 'lazy'
              -%}
          
            <div class="col-xl-{{ block.settings.img_product_column_handle }} col-md-{{ block.settings.img_product_column_handle_md }} col-sm-12">
              <div class="banner-img-2 pr-10 scroll-zoom promotion_video_btn border__radius">
                {%- if block.settings.promotion_img_enable -%}
                    <a href="{{ block.settings.btn1_url }}" class="lazyload-wraper-position" style="padding-top:{{ 1 | divided_by: block.settings.img1.aspect_ratio | times: 100}}%;">
                    {%- if block.settings.img1 -%}
                        {% assign image_height = block.settings.img1.width | divided_by: block.settings.img1.aspect_ratio %}
                        {{ block.settings.img1 | image_url: width: 3840 | image_tag: width: block.settings.img1.width, height: image_height, 
                        widths: widths, fetchpriority: fetch_priority, class: image_class, loading: lazy_load, alt: image.alt}}
                    {%- else -%}
                      <img loading="lazy"  class="animated" src="https://via.placeholder.com/760x550" alt="{{ image.alt }}">
                    {%- endif -%}
                  </a>
                {%- endif -%}

                {%- if block.settings.video_btn_enable -%}
                  <a class="video-popup magni_video_pop" href="{{ block.settings.video_btn_url }}">
                    <i class="icofont-play"></i>
                  </a>
                {%- endif -%}
              </div>
            </div>
          

          {%- when 'promoton-content' -%}
            <div class="col-xl-{{ block.settings.content_product_column_handle }} col-md-{{ block.settings.content_product_column_handle_md }} col-sm-12">
              <div class="banner-bg-content scroll-zoom">
                {%- if block.settings.t1 != '' -%}
                  <h3>{{ block.settings.t1 }}</h3>
                {%- endif -%}

                {%- if block.settings.t2 != '' -%}
                  <h2>{{ block.settings.t2 }}</h2>
                {%- endif -%}

                {%- if block.settings.des_text != '' -%}
                  <p>{{ block.settings.des_text }}</p>
                {%- endif -%}

                {%- if block.settings.countdown_date != '' -%}
                  <div class="count_down_wrapper {% if block.settings.count_border_disable %} count_border_disable{%endif%} ">
                    <div data-countdown="{{ block.settings.countdown_date }}"></div>
                  </div>
                {%- endif -%}

                {%- if block.settings.btn1 != '' -%}
                  <a class="ban_btn1 {{ block.settings.button_style }}" href="{{ block.settings.btn1_url }}">
                    {{- block.settings.btn1 -}}
                  </a>
                {%- endif -%}
              </div>
            </div>

            {% if block.settings.content_custom_color %}
              {% style %}
                  {%- assign top_title = block.settings.top_title -%}
                  {%- assign bottom_title = block.settings.bottom_title -%}
                  {%- assign des_text_font = block.settings.des_text_font -%}
                  {%- assign button_title = block.settings.button_title -%}

                  {{ top_title | font_face }}
                  {{ bottom_title | font_face }}
                  {{ des_text_font | font_face }}
                  {{ button_title | font_face }}


                  #section-{{ section.id }}.countdown_promotion_banner .banner-bg-content h3 {
                    color:{{ block.settings.t1_color }};
                    font-family: {{ bottom_title.family }}, {{ bottom_title.fallback_families }};
                    font-style: {{ bottom_title.style }};
                    font-weight: {{ bottom_title.weight }};
                    font-size:{{ block.settings.bottom_title_font_size }}px;
                    line-height:{{ block.settings.bottom_title_font_line_height }}px;
                    margin: 0 0 {{ block.settings.bottom_title_margin }}px;

                    {% if block.settings.title_1_gradient_style %}
                    	background-image: linear-gradient(180deg, {{ block.settings.t1_color | hex_to_rgba: 0.2 }}, {{ block.settings.t1_color | hex_to_rgba: 0 }} 100%);
                    	color: #0000;
                    	-webkit-box-decoration-break: clone;
                    	box-decoration-break: clone;
                    	-webkit-background-clip: text;
                    	background-clip: text;
                    {%- endif -%}
                  }


                  #section-{{ section.id }}.countdown_promotion_banner .banner-bg-content h2 {
                    color:{{ block.settings.t2_color }};
                    font-family: {{ top_title.family }}, {{ top_title.fallback_families }};
                    font-style: {{ top_title.style }};
                    font-weight: {{ top_title.weight }};
                    font-size:{{ block.settings.top_title_font_size }}px;
                    line-height:{{ block.settings.top_title_font_line_height }}px;
                    margin: 0 0 {{ block.settings.top_title_margin }}px;
                  }


                  #section-{{ section.id }}.countdown_promotion_banner .banner-bg-content p {
                    color:{{ block.settings.des_text_color }};
                    font-family: {{ des_text_font.family }}, {{ des_text_font.fallback_families }};
                    font-style: {{ des_text_font.style }};
                    font-weight: {{ des_text_font.weight }};
                    font-size:{{ block.settings.des_text_font_size }}px;
                    margin: 0 0 {{ block.settings.des_text_font_margin }}px;
                    line-height:{{ block.settings.des_text_font_line_height }}px;
                  }


                  @media (min-width: 768px) and (max-width: 992px) {

                  #section-{{ section.id }}.countdown_promotion_banner .banner-bg-content h3 {
                  	font-size:{{ block.settings.bottom_title_font_size_md }}px;
                 	line-height:{{ block.settings.bottom_title_font_line_height_md }}px;
                  }
                  #section-{{ section.id }}.countdown_promotion_banner .banner-bg-content h2 {
                  	font-size:{{ block.settings.top_title_font_size_md }}px;
                  	line-height:{{ block.settings.top_title_font_line_height_md }}px;
                  }
                  #section-{{ section.id }}.countdown_promotion_banner .banner-bg-content p {
                  	font-size:{{ block.settings.des_text_font_size_md }}px;
                  	line-height:{{ block.settings.des_text_font_line_height_md }}px;
                  }

                  }

                  @media (min-width: 300px) and (max-width: 767px) {

                  #section-{{ section.id }}.countdown_promotion_banner .banner-bg-content h3 {
                  	font-size:{{ block.settings.bottom_title_font_size_sm }}px;
                  	line-height:{{ block.settings.bottom_title_font_line_height_sm }}px;
                  }
                  #section-{{ section.id }}.countdown_promotion_banner .banner-bg-content h2 {
                  	font-size:{{ block.settings.top_title_font_size_sm }}px;
                  	line-height:{{ block.settings.top_title_font_line_height_sm }}px;
                  }
                  #section-{{ section.id }}.countdown_promotion_banner .banner-bg-content p {
                  	font-size:{{ block.settings.des_text_font_size_sm }}px;
                  	line-height:{{ block.settings.des_text_font_line_height_sm }}px;
                  }

                  }



                  #section-{{ section.id }} .count_down_wrapper .single-countdown {
                  	border-radius: {{ block.settings.border_radius_count }}px;
                  }

                  #section-{{ section.id }} .banner-bg-content a.ban_btn1 {
                  	font-family: {{ button_title.family }}, {{ button_title.fallback_families }};
                  	font-style: {{ button_title.style }};
                  	font-weight: {{ button_title.weight }};
                  	font-size:{{ block.settings.button_title_font_size }}px;
                  	margin: {{ block.settings.button_title_margin }}px 0 0;
                  	color: {{ block.settings.btn1_color }};
                  }

                  #section-{{ section.id }} .banner-bg-content a.ban_btn1:hover {
                  	color: {{ block.settings.btn1_hover_color }};
                  }

                  #section-{{ section.id }} .banner-bg-content a.ban_btn1.banner_style_2{
                  	border: 1px solid {{ block.settings.btn1_border_color }};
                  	background: {{ block.settings.btn1_bg_color }};
                  	border-radius: {{ block.settings.button_border_radius }}px;
                  	padding:{{block.settings.button_padding_tb}}px {{block.settings.button_padding_lr}}px;
                  }

                  #section-{{ section.id }} .banner-bg-content a.ban_btn1.banner_style_2:hover{
                  	background: {{ block.settings.btn1_bg_hover_color }};
                  	border: 1px solid {{ block.settings.btn1_border_hover_color }};
                  }



                  {%- if block.settings.heading_bottom_border_line -%}

                  #section-{{ section.id }}.countdown_promotion_banner .banner-bg-content h2 {
                  	position: relative;
                  }

                  #section-{{ section.id }}.countdown_promotion_banner .banner-bg-content h2::before {
                  	position: absolute;
                  	content: "";
                  	background: {{ block.settings.heading_border_bottom_color }};
                  	height: 4px;
                  	width: 70px;
                  	bottom: -{{block.settings.border_top_spacing}}px;
                  }

                {%- endif -%}
              {% endstyle %}
            {% endif %}


          
          {%- when 'promoton-code' -%}

          <div class="col-12">
            <div class="promo__code__wrapper">
              <div class="promo__code__img__content">

                <div class="promo__code__img">
                  {%- if block.settings.pc__image -%}
                    <img loading="lazy" class="animated" src="{{ block.settings.pc__image | img_url: 'master' }}" alt="{{ image.alt }}">
                  {%- else -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#e05c6a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="48" height="48">
                      <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                      <line x1="7" y1="7" x2="7.01" y2="7"/>
                    </svg>
                  {%- endif -%}
                </div>

                <div class="promo__code__content">
                  {%- if block.settings.pc__main__title != '' -%}
                    <h3>{{ block.settings.pc__main__title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.pc__sub__title != '' -%}
                    <p>{{ block.settings.pc__sub__title }}</p>
                  {%- endif -%}
                </div>

              </div>

              {%- if block.settings.pc__promo__code != '' -%}
                <div class="promo__code__promo">
                  <span class="promo__dots" id="promo-txt">••••••••</span>
                  <span id="promo-txt-real" style="display:none;">{{ block.settings.pc__promo__code }}</span>
                  <button id="promo-txt-button" class="promo-txt-button" onclick="togglePromo();" title="Show/Copy Code">Copy</button>
                </div>
              {%- endif -%}

            </div>

            <script>
              function togglePromo() {
                var dots = document.getElementById('promo-txt');
                var real = document.getElementById('promo-txt-real');
                var button = document.getElementById('promo-txt-button');
                var code = real.innerText;
                navigator.clipboard.writeText(code).then(function() {
                  dots.innerText = code;
                  dots.style.letterSpacing = 'normal';
                  dots.style.fontSize = '14px';
                  var orig = button.innerText;
                  button.innerText = 'Copied!';
                  setTimeout(function() {
                    button.innerText = orig;
                    dots.innerText = '••••••••';
                    dots.style.letterSpacing = '3px';
                    dots.style.fontSize = '20px';
                  }, 1500);
                }, function() {
                  button.style.background = 'red';
                  button.innerText = 'Error';
                });
              }
            </script>

            <style>
              .promo__code__wrapper {
                padding: 18px 24px;
                border: 2px dashed #e8a0a8;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                background: #fff;
                gap: 12px;
              }
              .promo__code__img__content {
                display: flex;
                align-items: center;
                gap: 14px;
                max-width: 70%;
              }
              .promo__code__img {
                flex-shrink: 0;
                width: 48px;
                display: flex;
                align-items: center;
                justify-content: center;
              }
              .promo__code__img img {
                width: 100%;
              }
              .promo__code__content h3 {
                margin: 0 0 4px;
                font-weight: 700;
                font-size: 15px;
                color: #1f2226;
                line-height: 1.3;
              }
              .promo__code__content p {
                margin: 0;
                font-size: 13px;
                color: #888;
                font-weight: normal;
              }
              .promo__code__promo {
                border: 2px dashed #e05c6a;
                padding: 10px 20px 18px;
                position: relative;
                border-radius: 10px;
                max-width: 30%;
                min-width: 120px;
                text-align: center;
              }
              .promo__dots {
                font-size: 20px;
                color: #e05c6a;
                font-weight: 700;
                letter-spacing: 3px;
                display: block;
              }
              .promo-txt-button {
                position: absolute;
                bottom: -12px;
                right: 8px;
                line-height: 1;
                border: 1.5px dashed #e05c6a;
                background: #fff;
                color: #e05c6a;
                font-size: 11px;
                font-weight: 600;
                padding: 3px 10px;
                border-radius: 20px;
                cursor: pointer;
                transition: .2s;
              }
              .promo-txt-button:hover {
                background: #e05c6a;
                color: #fff;
              }
              @media (max-width: 767px) {
                .promo__code__wrapper {
                  padding: 20px;
                  justify-content: center;
                }
                .promo__code__img__content {
                  max-width: 100%;
                }
                .promo__code__promo {
                  max-width: 100%;
                  width: 100%;
                  text-align: center;
                }
              }
            </style>

          </div>


          {%- when 'promotion-faq' -%}
            <div class="col-xl-{{ block.settings.faq_column_handle }} col-md-{{ block.settings.faq_column_handle_md }} col-sm-12 faq-page">
              <div id="section-{{ section.id }}-accordion">
                {% if block.settings.accordion_content_1 != '' -%}
                  <div class="card">
                    <div class="card-header" id="section-{{ section.id }}-heading-1">
                      <h5 class="mb-0">
                        <button
                          class="btn-link collapsed"
                          data-toggle="collapse"
                          data-target="#section-{{ section.id }}-collapse-1"
                          aria-expanded="true"
                          aria-controls="section-{{ section.id }}-collapse-1"
                        >
                          {{ block.settings.accordion_title_1 }}
                        </button>
                      </h5>
                    </div>
                    <div
                      id="section-{{ section.id }}-collapse-1"
                      class="collapse show"
                      aria-labelledby="section-{{ section.id }}-heading-1"
                      data-parent="#section-{{ section.id }}-accordion"
                    >
                      <div class="card-body">
                        {{ block.settings.accordion_content_1 }}
                      </div>
                    </div>
                  </div>
                {% endif %}

                {% if block.settings.accordion_content_2 != '' -%}
                  <div class="card">
                    <div class="card-header" id="section-{{ section.id }}-heading-2">
                      <h5 class="mb-0">
                        <button
                          class="btn-link"
                          data-toggle="collapse"
                          data-target="#section-{{ section.id }}-collapse-2"
                          aria-expanded="true"
                          aria-controls="section-{{ section.id }}-collapse-2"
                        >
                          {{ block.settings.accordion_title_2 }}
                        </button>
                      </h5>
                    </div>
                    <div
                      id="section-{{ section.id }}-collapse-2"
                      class="collapse"
                      aria-labelledby="section-{{ section.id }}-heading-2"
                      data-parent="#section-{{ section.id }}-accordion"
                    >
                      <div class="card-body">
                        {{ block.settings.accordion_content_2 }}
                      </div>
                    </div>
                  </div>
                {% endif %}

                {% if block.settings.accordion_content_3 != '' -%}
                  <div class="card">
                    <div class="card-header" id="section-{{ section.id }}-heading-3">
                      <h5 class="mb-0">
                        <button
                          class="btn-link"
                          data-toggle="collapse"
                          data-target="#section-{{ section.id }}-collapse-3"
                          aria-expanded="true"
                          aria-controls="section-{{ section.id }}-collapse-3"
                        >
                          {{ block.settings.accordion_title_3 }}
                        </button>
                      </h5>
                    </div>
                    <div
                      id="section-{{ section.id }}-collapse-3"
                      class="collapse"
                      aria-labelledby="section-{{ section.id }}-heading-3"
                      data-parent="#section-{{ section.id }}-accordion"
                    >
                      <div class="card-body">
                        {{ block.settings.accordion_content_3 }}
                      </div>
                    </div>
                  </div>
                {% endif %}

                {% if block.settings.accordion_content_4 != '' -%}
                  <div class="card">
                    <div class="card-header" id="section-{{ section.id }}-heading-4">
                      <h5 class="mb-0">
                        <button
                          class="btn-link"
                          data-toggle="collapse"
                          data-target="#section-{{ section.id }}-collapse-4"
                          aria-expanded="true"
                          aria-controls="section-{{ section.id }}-collapse-4"
                        >
                          {{ block.settings.accordion_title_4 }}
                        </button>
                      </h5>
                    </div>
                    <div
                      id="section-{{ section.id }}-collapse-4"
                      class="collapse"
                      aria-labelledby="section-{{ section.id }}-heading-4"
                      data-parent="#section-{{ section.id }}-accordion"
                    >
                      <div class="card-body">
                        {{ block.settings.accordion_content_4 }}
                      </div>
                    </div>
                  </div>
                {% endif %}

                {% if block.settings.accordion_content_5 != '' -%}
                  <div class="card">
                    <div class="card-header" id="section-{{ section.id }}-heading-5">
                      <h5 class="mb-0">
                        <button
                          class="btn-link"
                          data-toggle="collapse"
                          data-target="#section-{{ section.id }}-collapse-5"
                          aria-expanded="true"
                          aria-controls="section-{{ section.id }}-collapse-5"
                        >
                          {{ block.settings.accordion_title_5 }}
                        </button>
                      </h5>
                    </div>
                    <div
                      id="section-{{ section.id }}-collapse-5"
                      class="collapse"
                      aria-labelledby="section-{{ section.id }}-heading-5"
                      data-parent="#section-{{ section.id }}-accordion"
                    >
                      <div class="card-body">
                        {{ block.settings.accordion_content_5 }}
                      </div>
                    </div>
                  </div>
                {% endif %}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
    #section-{{ section.id }} .count_down_wrapper .single-countdown {
      background: {{ settings.body_bg_color }};
    }

    #section-{{ section.id }} .count_down_wrapper.count_border_disable .single-countdown {
      background: none;
      border:none;
      text-align:left;
      padding-left:0;
    }
    .count_down_wrapper.count_border_disable .count-number {
      margin-bottom: 10px;
    }

    #section-{{ section.id }} .promotion_video_btn{
      position: relative;
    }

    #section-{{ section.id }} .promotion_video_btn .magni_video_pop {
      position: absolute;
      left: 50%;
      top: 50%;
      height: 90px;
      width: 90px;
      border: 1px solid #fff;
      border-radius: 100%;
      text-align: center;
      line-height: 90px;
      font-size: 20px;
      background: #fff;
      color: {{ settings.color_primary }};
      transition: .3s;
      margin-left: -45px;
      margin-top: -45px;
    }
    #section-{{ section.id }} .promotion_video_btn .magni_video_pop:hover {
      transform: scale(1.15);
      background: transparent;
      color: {{ settings.color_primary }};
      border:1px solid {{ settings.color_primary }};
    }



    #section-{{ section.id }} .faq-page .card .card-header button {
      color: {{ settings.content_color }};
      transition: .3s;
    }
    #section-{{ section.id }} .faq-page .card .card-header button:hover {
      color: {{ settings.color_primary }};
    }
    #section-{{ section.id }} .faq-page .card-body p{
      color: {{ settings.content_color }};
    }
    #section-{{ section.id }} .card {
      background-color: {{ settings.body_bg_color }};
    }

  {% if section.settings.section__inner__bg__enable %}
  #section-{{ section.id }}.countdown_promotion_banner .banner-bg-content {
      padding-right: 100px;
    }
      #section-{{ section.id }}.countdown_promotion_banner .row {
        background: {{ section.settings.section__inner__bg__color }};
        padding: 90px 60px;
        border-radius: 10px;
      }
      @media (max-width: 991px){

        #section-{{ section.id }}.countdown_promotion_banner .row{
              padding:50px 20px;
          }
        #section-{{ section.id }}.countdown_promotion_banner .banner-bg-content {
          padding-right: 0;
           margin-bottom:20px;
        }

      }
      {% endif %}
</style>

{%- render 'section-style' -%}

{%- render 'heading-style' -%}

<script>
  $('.count_down_wrapper [data-countdown]').each(function() {
    var $this = $(this), finalDate = $(this).data('countdown');
    $this.countdown(finalDate, function(event) {
      $this.html(event.strftime('<div class="countdown-area"><div class="single-countdown"><div class="count-number">%D</div><div class="count-title">days</div></div><div class="single-countdown"><div class="count-number">%H</div><div class="count-title">Hour</div></div><div class="single-countdown"><div class="count-number">%M</div><div class="count-title">Mint</div></div><div class="single-countdown"><div class="count-number">%S</div><div class="count-title">Sec</div></div></div>'));
    });
  });
</script>

{% schema %}
 {
   "name": "Promotion Banner",
   "settings": [
             {
               "type": "select",
               "id": "section_width",
               "label": "Section Width",
               "options":[
                     {
                         "label": "Full Width",
                         "value": "full_width"
                     },
                     {
                         "label": "Box Width",
                         "value": "box_width"
                     },
                     {
                         "label": "Default Width",
                         "value": "default"
                     }
                 ],
                 "default": "default"
             },



	{
		"type": "header",
           "content": "Section Title"
       },

       {
         "type": "checkbox",
         "id": "section_title_custom_color",
         "label": "Section Title Custom Style Enable",
         "default": false
       },

	{
           "type": "text",
           "id": "section_title",
           "label": "Title",
           "default": "New Arrivals"
       },

       {
         "type": "color",
         "id": "section_title_color",
         "label": "Title Color",
         "default": "#1f2226"
       },
         {
           "type": "font_picker",
           "id": "section_title_font",
           "label": "Font Family: Section Title Font",
           "default": "poppins_n6"
