{{ 'Custom_Collection_Template.css' | asset_url | stylesheet_tag }}

<div class="shop-area pt-50 pb-100 section-padding-3" id="section-{{ section.id }}" data-section="collectionTemplate">
  <div class="container{% if section.settings.full_width == 'full_width' %}-fluid{% endif %}">
    <div class="row{% if section.settings.sidebar_handle == 'left_sidebar_handle' %} flex-row-reverse{% endif %}">
      
      <!-- Product Grid Column -->
      <div class="{% if section.settings.sidebar_handle == 'without_sidebar' %}col-lg-12{% else %}col-lg-9{% endif %}">
        {%- if cart.attributes.pagination != blank -%}
          {%- assign products_limit = cart.attributes.pagination -%}
        {%- else -%}
          {%- assign products_limit = section.settings.products_limit_handle -%}
        {%- endif -%}
        
        {%- paginate collection.products by products_limit -%}
          {%- if section.settings.tab_bar_enable or section.settings.short_by_enable or section.settings.showing_product_counter_enable -%}
            <div class="shop-top-bar">
              {%- render 'collection-sorting', paginate: paginate, products_limit: products_limit -%}
            </div>
          {%- endif -%}

          <div class="shop-bottom-area mt-35">
            <div class="tab-content jump">
              <div>
                <div class="row theme-products {% if section.settings.product_column_xs == '6'%}custom_mobile_class {% endif %}">
                  {%- for product in collection.products -%}
                    {% if product.type == 'PPLR_HIDDEN_PRODUCT' %}{% continue %}{% endif %}
                    <div class="col-xl-{{ section.settings.product_column }} col-lg-{{ section.settings.product_column_lg }} col-md-{{ section.settings.product_column_md }} col-sm-{{ section.settings.product_column_sm }} col-{{ section.settings.product_column_xs }}">
                      {% render 'product-grid-item', product: product -%}
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            </div>
            
            <div class="pro-pagination-style text-center mt-30">
              {%- render 'pagination', paginate: paginate -%}

              {% if section.settings.pagination_custom_style %}
                <style>
                  #section-{{ section.id }} .pro-pagination-style ul li a,
                  #section-{{ section.id }} .pro-pagination-style ul li a.prev,
                  #section-{{ section.id }} .pro-pagination-style ul li a.next {
                    color: {{ section.settings.pagination_color }};
                    background:{{ section.settings.pagination_bg_color }};
                    border-radius:{{section.settings.pagination_border_radius}}px
                  }
                  #section-{{ section.id }} .pro-pagination-style ul li a:hover,
                  #section-{{ section.id }} .pro-pagination-style ul li a.prev:hover,
                  #section-{{ section.id }} .pro-pagination-style ul li a.next:hover {
                    color: {{ section.settings.pagination_hover_color }};
                    background: {{ section.settings.pagination_bg_hover_color }};
                  }
                  #section-{{ section.id }} .pro-pagination-style ul li a.active {
                    color: {{ section.settings.pagination_active_color }};
                    background: {{ section.settings.pagination_active_bg_color }};
                  }
                </style>
              {% endif %}
            </div>
          </div>
        {%- endpaginate -%}
      </div>

      <!-- Modernized Filter Sidebar Column -->
      {%- unless section.settings.sidebar_handle == 'without_sidebar' -%}
        <div class="col-lg-3 sidebar__filter__responsive">
          
          <button type="button" class="theme-default-button sidebar-collapse-btn">
            <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 0 32 32" width="24"><g id="Layer_2" data-name="Layer 2"><path d="m28.552 6.184h-2.671a4.556 4.556 0 0 0 -8.659 0h-13.774a1.449 1.449 0 0 0 0 2.9h13.774a4.556 4.556 0 0 0 8.659 0h2.671a1.449 1.449 0 0 0 0-2.9zm-7 3.138a1.69 1.69 0 1 1 1.689-1.69 1.692 1.692 0 0 1 -1.689 1.69z"></path><path d="m28.552 14.552h-13.774a4.556 4.556 0 0 0 -8.659 0h-2.671a1.448 1.448 0 0 0 0 2.9h2.671a4.556 4.556 0 0 0 8.659 0h13.774a1.448 1.448 0 0 0 0-2.9zm-18.1 3.138a1.69 1.69 0 1 1 1.686-1.69 1.692 1.692 0 0 1 -1.69 1.69z"></path><path d="m28.552 22.919h-2.671a4.556 4.556 0 0 0 -8.659 0h-13.774a1.449 1.449 0 0 0 0 2.9h13.774a4.556 4.556 0 0 0 8.659 0h2.671a1.449 1.449 0 0 0 0-2.9zm-7 3.138a1.69 1.69 0 1 1 1.689-1.689 1.692 1.692 0 0 1 -1.689 1.689z"></path></g></svg>
            Filter
          </button>

          <div class="sidebar-collapse-hide">
            <div class="native-storefront-sidebar-card">
              <form id="StorefrontFiltersForm" class="storefront-filter-form">
                
                {%- for filter in collection.filters -%}
                  <div class="storefront-filter-group" data-index="{{ forloop.index }}">
                    <div class="storefront-filter-header">
                      <span>{{ filter.label }}</span>
                      <span class="storefront-filter-icon">-</span>
                    </div>
                    
                    <div class="storefront-filter-content">
                      {%- case filter.type -%}
                        {%- when 'list' -%}
                          <div class="filter-selected-pill">
                            {{ filter.active_values.size }} selected
                          </div>
                          <ul class="filter-checkbox-list">
                            {%- for value in filter.values -%}
                              <li class="filter-checkbox-item">
                                <label class="filter-label-wrapper">
                                  <input type="checkbox" 
                                         name="{{ value.param_name }}" 
                                         value="{{ value.value }}" 
                                         {% if value.active %}checked{% endif %}
                                         {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                                  <span class="custom-checkbox-text">{{ value.label }}</span>
                                </label>
                                <span class="filter-item-count">({{ value.count }})</span>
                              </li>
                            {%- endfor -%}
                          </ul>

                        {%- when 'price_range' -%}
                          <div class="filter-selected-pill">
                            {%- if filter.min_value.value or filter.max_value.value -%}active{%- else -%}selected{%- endif -%}
                          </div>
                          <div class="price-range-inputs-container">
                            <div class="price-input-box">
                              <span class="currency-symbol">{{ cart.currency.symbol }}</span>
                              <input name="{{ filter.min_value.param_name }}"
                                     id="Filter-{{ filter.label | handle }}-GTE"
                                     {%- if filter.min_value.value -%}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{%- endif -%}
                                     type="number"
                                     placeholder="0"
                                     min="0"
                                     max="{{ filter.range_max | money_without_currency | replace: ',', '' }}">
                            </div>
                            <span class="price-range-label">From</span>
                            
                            <div class="price-input-box">
                              <span class="currency-symbol">{{ cart.currency.symbol }}</span>
                              <input name="{{ filter.max_value.param_name }}"
                                     id="Filter-{{ filter.label | handle }}-LTE"
                                     {%- if filter.max_value.value -%}value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{%- endif -%}
                                     type="number"
                                     placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                                     min="0"
                                     max="{{ filter.range_max | money_without_currency | replace: ',', '' }}">
                            </div>
                            <span class="price-range-label">To</span>
                          </div>
                          <button type="submit" class="storefront-price-submit-btn">Filter</button>
                      {%- endcase -%}
                    </div>
                  </div>
                {%- endfor -%}

              </form>
            </div>
          </div>
          
        </div>
      {%- endunless -%}
      
    </div>
  </div>
</div>

<!-- Interface Customization Styling -->
<style>
  .native-storefront-sidebar-card {
    background: #ffffff;
    border: 1px solid #f2f2f2;
    border-radius: 28px;
    padding: 30px 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.01);
    font-family: inherit;
  }
  .storefront-filter-group {
    border-bottom: 1px solid #f8f8f8;
    padding: 22px 0;
  }
  .storefront-filter-group:last-child {
    border-bottom: none;
  }
  .storefront-filter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.3px;
    cursor: pointer;
    color: #000000;
    user-select: none;
  }
  .storefront-filter-icon {
    font-size: 20px;
    color: #000;
    font-weight: 400;
  }
  .storefront-filter-content {
    margin-top: 18px;
    transition: all 0.25s ease-in-out;
  }
  .filter-selected-pill {
    display: inline-block;
    border: 1px dashed #d1d1d1;
    border-radius: 20px;
    padding: 4px 14px;
    font-size: 13px;
    color: #222222;
    margin-bottom: 16px;
    font-weight: 300;
  }
  .filter-checkbox-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-height: 240px;
    overflow-y: auto;
    padding-right: 6px;
  }
  .filter-checkbox-list::-webkit-scrollbar {
    width: 4px;
  }
  .filter-checkbox-list::-webkit-scrollbar-thumb {
    background: #a0a0a0;
    border-radius: 10px;
  }
  .filter-checkbox-list::-webkit-scrollbar-track {
    background: #f1f1f1;
  }
  .filter-checkbox-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    font-size: 15px;
    color: #2c2c2c;
  }
  .filter-label-wrapper {
    display: flex;
    align-items: center;
    cursor: pointer;
    margin: 0;
    font-weight: 400;
  }
  .filter-label-wrapper input[type="checkbox"] {
    margin-right: 12px;
    width: 17px;
    height: 17px;
    border: 1px solid #7a7a7a;
    border-radius: 4px;
    cursor: pointer;
    accent-color: #000;
  }
  .custom-checkbox-text {
    font-weight: 300;
    color: #111;
  }
  .filter-item-count {
    color: #111;
    font-weight: 300;
    padding-left: 8px;
  }
  .price-range-inputs-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 16px;
    row-gap: 4px;
    margin-bottom: 18px;
  }
  .price-input-box {
    display: flex;
    align-items: center;
    border: 1px solid #e2e2e2;
    padding: 10px 12px;
    border-radius: 4px;
    background: #fff;
  }
  .currency-symbol {
    color: #444;
    margin-right: 6px;
    font-size: 14px;
  }
  .price-input-box input {
    border: none;
    width: 100%;
    outline: none;
    font-size: 15px;
    color: #333;
    font-weight: 300;
  }
  .price-range-label {
    font-size: 13px;
    color: #444444;
    grid-row: 2;
    margin-top: 2px;
    font-weight: 300;
  }
  .storefront-price-submit-btn {
    width: 100%;
    background: #cf0404;
    color: #ffffff;
    border: none;
    padding: 13px;
    border-radius: 24px;
    font-weight: 700;
    font-size: 16px;
    cursor: pointer;
    transition: background 0.2s ease;
    letter-spacing: 0.5px;
  }
  .storefront-price-submit-btn:hover {
    background: #b00202;
  }
</style>

<!-- Collapsible Panel Accordion Toggles & Automatic Form Updates -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Accordion interaction mechanics (+/- toggles)
    const headers = document.querySelectorAll('.storefront-filter-header');
    headers.forEach(header => {
      header.addEventListener('click', function() {
        const content = this.nextElementSibling;
        const icon = this.querySelector('.storefront-filter-icon');
        
        if (content.style.display === 'none') {
          content.style.display = 'block';
          icon.textContent = '-';
        } else {
          content.style.display = 'none';
          icon.textContent = '+';
        }
      });
    });

    // Auto-submits search query params down to Shopify whenever a checkbox modifies states
    const filterForm = document.getElementById('StorefrontFiltersForm');
    if (filterForm) {
      filterForm.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
        checkbox.addEventListener('change', () => {
          filterForm.submit();
        });
      });
    }
  });
</script>

