<div class="about-hero-section" id="about-hero-{{ section.id }}">
  <div class="about-hero-wrapper" style="min-height: {{ section.settings.section_height }}px;">

    {%- if section.settings.hero_image != blank -%}
      {%- assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840' -%}
      {{ section.settings.hero_image | image_url: width: 3840 | image_tag:
        widths: widths,
        loading: 'lazy',
        fetchpriority: 'high',
        class: 'about-hero-image',
        alt: section.settings.hero_image.alt | default: section.settings.heading
      }}
    {%- else -%}
      <img class="about-hero-image" src="https://via.placeholder.com/1920x820" alt="">
    {%- endif -%}

    <div class="about-hero-overlay" style="background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

    <div class="container">
      <div class="about-hero-content text-{{ section.settings.content_alignment }}">

        {%- if section.settings.heading != blank -%}
          <h1 class="about-hero-heading" style="color: {{ section.settings.heading_color }};">
            {{ section.settings.heading }}
          </h1>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="about-hero-description" style="color: {{ section.settings.description_color }};">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <div class="about-hero-button-wrap">
            <a href="{{ section.settings.button_link }}" class="about-hero-button">
              {{ section.settings.button_label }}
            </a>
          </div>
        {%- endif -%}

      </div>
    </div>

  </div>
</div>

{%- style -%}
  #about-hero-{{ section.id }} .about-hero-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: {{ section.settings.vertical_alignment }};
    overflow: hidden;
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
  }

  #about-hero-{{ section.id }} .about-hero-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  #about-hero-{{ section.id }} .about-hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  #about-hero-{{ section.id }} .container {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  #about-hero-{{ section.id }} .about-hero-content {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
  }

  #about-hero-{{ section.id }} .about-hero-content.text-left {
    margin-left: 0;
  }

  #about-hero-{{ section.id }} .about-hero-content.text-right {
    margin-right: 0;
  }

  #about-hero-{{ section.id }} .about-hero-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 20px 0;
  }

  #about-hero-{{ section.id }} .about-hero-description {
    font-size: {{ section.settings.description_size }}px;
    font-weight: 600;
    line-height: 1.6;
    margin: 0 auto;
  }

  #about-hero-{{ section.id }} .about-hero-description p {
    margin: 0;
  }

  #about-hero-{{ section.id }} .about-hero-description,
  #about-hero-{{ section.id }} .about-hero-description * {
    color: inherit;
  }

  #about-hero-{{ section.id }} .about-hero-description strong,
  #about-hero-{{ section.id }} .about-hero-description b {
    font-weight: 800;
  }

  #about-hero-{{ section.id }} .about-hero-button-wrap {
    margin-top: 30px;
  }

  #about-hero-{{ section.id }} .about-hero-button {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    font-weight: 600;
    text-decoration: none;
    border-radius: {{ section.settings.button_radius }}px;
    transition: opacity 0.2s ease;
  }

  #about-hero-{{ section.id }} .about-hero-button:hover {
    opacity: 0.85;
  }

  @media only screen and (max-width: 767px) {
    #about-hero-{{ section.id }} .about-hero-wrapper {
      min-height: {{ section.settings.section_height_mobile }}px;
      padding-top: {{ section.settings.section_padding_top_mobile }}px;
      padding-bottom: {{ section.settings.section_padding_bottom_mobile }}px;
    }

    #about-hero-{{ section.id }} .about-hero-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    #about-hero-{{ section.id }} .about-hero-description {
      font-size: {{ section.settings.description_size_mobile }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "About Hero",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fueling Australia's Automotive Passion"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Professional grade automotive parts, genuine quality, and expert knowledge for the true enthusiast and professional mechanic.</p>"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical Alignment",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content Max Width",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 800
    },
    {
      "type": "header",
      "content": "Text Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Text Sizes (Desktop)"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description Size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Text Sizes (Mobile)"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size",
      "min": 16,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "label": "Description Size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Button (optional)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background",
      "default": "#dd0000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button Corner Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Section Height & Spacing (Desktop)"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Min Height",
      "min": 300,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 620
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Section Height & Spacing (Mobile)"
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "label": "Section Min Height",
      "min": 250,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "About Hero"
    }
  ]
}
{% endschema %}
