<div class="feature-highlights-section" id="feature-highlights-{{ section.id }}">
  <div class="container">

    <div class="feature-highlights-header text-{{ section.settings.header_alignment }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="feature-highlights-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="feature-highlights-subheading">
          {{ section.settings.subheading }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="feature-highlights-grid" style="--fh-columns: {{ section.settings.columns_desktop }};">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            <div class="feature-highlights-card" {{ block.shopify_attributes }}>

              {%- if block.settings.icon_image != blank or block.settings.preset_icon != 'none' -%}
                <div class="feature-highlights-icon-box">
                  {%- if block.settings.icon_image != blank -%}
                    {{ block.settings.icon_image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'feature-highlights-icon feature-highlights-icon-image', alt: block.settings.title }}
                  {%- elsif block.settings.preset_icon != 'none' -%}
                    <span class="feature-highlights-icon feature-highlights-icon-svg">
                      {%- render 'vfp-icon', icon: block.settings.preset_icon -%}
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h3 class="feature-highlights-card-title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <div class="feature-highlights-card-description">
                  {{ block.settings.description }}
                </div>
              {%- endif -%}

            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{%- style -%}
  #feature-highlights-{{ section.id }} {
    background-color: {{ section.settings.section_bg_color }};
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
  }

  #feature-highlights-{{ section.id }} .feature-highlights-header {
    max-width: {{ section.settings.header_max_width }}px;
    margin: 0 auto {{ section.settings.header_bottom_spacing }}px auto;
  }

  #feature-highlights-{{ section.id }} .feature-highlights-header.text-left {
    margin-left: 0;
  }

  #feature-highlights-{{ section.id }} .feature-highlights-header.text-right {
    margin-right: 0;
  }

  #feature-highlights-{{ section.id }} .feature-highlights-heading {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 16px 0;
  }

  #feature-highlights-{{ section.id }} .feature-highlights-subheading {
    color: {{ section.settings.subheading_color }};
    font-size: {{ section.settings.subheading_size }}px;
    line-height: 1.6;
  }

  #feature-highlights-{{ section.id }} .feature-highlights-subheading p {
    margin: 0;
  }

  #feature-highlights-{{ section.id }} .feature-highlights-grid {
    display: grid;
    grid-template-columns: repeat(var(--fh-columns), 1fr);
    gap: {{ section.settings.card_gap }}px;
  }

  #feature-highlights-{{ section.id }} .feature-highlights-card {
    background-color: {{ section.settings.card_bg_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    text-align: {{ section.settings.card_content_alignment }};
  }

  #feature-highlights-{{ section.id }} .feature-highlights-icon-box {
    width: {{ section.settings.icon_box_size }}px;
    height: {{ section.settings.icon_box_size }}px;
    background-color: {{ section.settings.icon_box_bg_color }};
    border-radius: {{ section.settings.icon_box_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    {%- if section.settings.card_content_alignment == 'center' -%}
    margin-left: auto;
    margin-right: auto;
    {%- endif -%}
  }

  #feature-highlights-{{ section.id }} .feature-highlights-icon-image {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    object-fit: contain;
  }

  #feature-highlights-{{ section.id }} .feature-highlights-icon-svg {
    display: inline-flex;
    color: {{ section.settings.icon_color }};
  }

  #feature-highlights-{{ section.id }} .feature-highlights-icon-svg svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
  }

  #feature-highlights-{{ section.id }} .feature-highlights-card-title {
    color: {{ section.settings.card_title_color }};
    font-size: {{ section.settings.card_title_size }}px;
    font-weight: 700;
    margin: 0 0 12px 0;
  }

  #feature-highlights-{{ section.id }} .feature-highlights-card-description {
    color: {{ section.settings.card_description_color }};
    font-size: {{ section.settings.card_description_size }}px;
    line-height: 1.7;
  }

  #feature-highlights-{{ section.id }} .feature-highlights-card-description p {
    margin: 0;
  }

  @media only screen and (max-width: 989px) {
    #feature-highlights-{{ section.id }} .feature-highlights-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
    }
  }

  @media only screen and (max-width: 767px) {
    #feature-highlights-{{ section.id }} {
      padding-top: {{ section.settings.section_padding_top_mobile }}px;
      padding-bottom: {{ section.settings.section_padding_bottom_mobile }}px;
    }

    #feature-highlights-{{ section.id }} .feature-highlights-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    }

    #feature-highlights-{{ section.id }} .feature-highlights-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Feature Highlights",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Metro Auto Standard"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>We don't compromise on quality. Every product we stock must meet our rigorous professional grade requirements.</p>"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "header_max_width",
      "label": "Header Max Width",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 780
    },
    {
      "type": "range",
      "id": "header_bottom_spacing",
      "label": "Space Below Header",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size (Desktop)",
      "min": 18,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size (Mobile)",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#5f6b7a"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (Desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns (Tablet)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap Between Cards",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Card Style"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Corner Radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card Padding",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "card_content_alignment",
      "label": "Card Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Icon Box"
    },
    {
      "type": "color",
      "id": "icon_box_bg_color",
      "label": "Icon Box Background",
      "default": "#f0f0f0"
    },
    {
      "type": "range",
      "id": "icon_box_size",
      "label": "Icon Box Size",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "icon_box_radius",
      "label": "Icon Box Corner Radius",
      "min": 0,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color (preset icons only)",
      "default": "#dd0000"
    },
    {
      "type": "header",
      "content": "Card Text"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Title Size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 19
    },
    {
      "type": "color",
      "id": "card_description_color",
      "label": "Description Color",
      "default": "#5f6b7a"
    },
    {
      "type": "range",
      "id": "card_description_size",
      "label": "Description Size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background Color",
      "default": "#f4f4f4"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    }
  ],
  "blocks": [
    {
      "name": "Feature",
      "type": "feature",
      "settings": [
        {
          "type": "select",
          "id": "preset_icon",
          "label": "Preset Icon",
          "info": "Ignored if a custom icon image is uploaded below",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "shield", "label": "Shield" },
            { "value": "funnel", "label": "Funnel" },
            { "value": "wrench", "label": "Wrench" },
            { "value": "award", "label": "Award" },
            { "value": "star", "label": "Star" },
            { "value": "restore", "label": "Restore" },
            { "value": "truck", "label": "Truck" },
            { "value": "pin", "label": "Pin" },
            { "value": "search", "label": "Search" }
          ],
          "default": "shield"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom Icon Image (overrides preset)",
          "info": "Upload your own icon to use instead of a preset"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "OEM Quality"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>We stock genuine and rigorous quality-checked aftermarket parts. We refuse to sell components we wouldn't install on our own high-performance vehicles.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Highlights",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "preset_icon": "shield",
            "title": "OEM Quality",
            "description": "<p>We stock genuine and rigorous quality-checked aftermarket parts. We refuse to sell components we wouldn't install on our own high-performance vehicles.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "preset_icon": "truck",
            "title": "Direct Sourcing",
            "description": "<p>By working directly with major automotive manufacturers globally, we ensure authenticity and competitive pricing, cutting out unnecessary middlemen.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "preset_icon": "wrench",
            "title": "Expert Knowledge",
            "description": "<p>Our staff aren't just salespeople; they are industry veterans and mechanics with decades of hands-on experience ready to provide technical support.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
