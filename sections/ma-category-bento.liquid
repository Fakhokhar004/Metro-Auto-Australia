{%- comment -%}
  "Shop by category" bento. Design reference: Main.dc.html (SHOP BY CATEGORY).
  One large feature tile + up to four category tiles.
{%- endcomment -%}
<section class="ma-bento-sec ma-sec--64">
  <div class="ma-wrap">
    <div class="ma-section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="ma-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        <h2 class="ma-h2">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="ma-section-head__link" href="{{ section.settings.link_url | default: routes.collections_url }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>

    <div class="ma-bento">
      <a class="ma-bento__feature" href="{{ section.settings.feature_url | default: routes.collections_url }}">
        {%- if section.settings.feature_image != blank -%}
          {{- section.settings.feature_image | image_url: width: 1200 | image_tag: class: 'ma-bento__bgimg', widths: '600,900,1200', sizes: '(min-width: 860px) 50vw, 100vw', loading: 'lazy', alt: '' -}}
        {%- else -%}
          <svg width="300" height="300" viewBox="0 0 200 200" fill="none" aria-hidden="true">
            <circle cx="110" cy="96" r="70" fill="#2A2C31" stroke="#4A4D55" stroke-width="2"/>
            <circle cx="110" cy="96" r="28" fill="#3A3D44"/><circle cx="110" cy="96" r="11" fill="#17181B"/>
            <path d="M48 56 C38 76 38 116 48 136 L66 128 C60 112 60 80 66 64 Z" fill="#E1251B"/>
            <rect x="150" y="120" width="28" height="70" rx="5" fill="#2F6FD6"/><rect x="150" y="140" width="28" height="22" fill="#FFFFFF"/>
          </svg>
        {%- endif -%}
        <span class="ma-bento__copy">
          {%- if section.settings.feature_eyebrow != blank -%}<span class="ma-bento__eyebrow">{{ section.settings.feature_eyebrow | escape }}</span>{%- endif -%}
          <span class="ma-bento__title">{{ section.settings.feature_title | escape }}</span>
          {%- if section.settings.feature_text != blank -%}<span class="ma-bento__text">{{ section.settings.feature_text | escape }}</span>{%- endif -%}
        </span>
      </a>

      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign label = block.settings.label | default: c.title
          if c != blank
            assign url = c.url
          else
            assign url = block.settings.label | handleize | prepend: '/collections/'
          endif
        -%}
        <a class="ma-bento__tile" href="{{ url }}" {{ block.shopify_attributes }}>
          <span class="ma-bento__art">
            {%- if block.settings.image != blank -%}
              {{- block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' -}}
            {%- else -%}
              {%- case block.settings.art -%}
                {%- when 'can' -%}
                  <svg width="60" height="100" viewBox="0 0 120 200" fill="none" aria-hidden="true"><rect x="52" y="4" width="16" height="12" rx="2" fill="#62666D"/><path d="M40 16h40v18H40z" fill="#FFFFFF"/><rect x="30" y="34" width="60" height="160" rx="10" fill="#2F6FD6"/><rect x="30" y="80" width="60" height="50" fill="#FFFFFF"/></svg>
                {%- when 'plug' -%}
                  <svg width="90" height="100" viewBox="0 0 120 160" fill="none" aria-hidden="true"><g><rect x="22" y="6" width="12" height="14" rx="2" fill="#B9BCC3"/><rect x="18" y="20" width="20" height="56" rx="8" fill="#F4F4F5"/><path d="M14 76h28l-3 14H17z" fill="#8A8E96"/><rect x="20" y="90" width="16" height="40" fill="#62666D"/><path d="M26 130h4v14h-4z" fill="#B9BCC3"/></g><g transform="translate(36 0)"><rect x="22" y="6" width="12" height="14" rx="2" fill="#B9BCC3"/><rect x="18" y="20" width="20" height="56" rx="8" fill="#F4F4F5"/><path d="M14 76h28l-3 14H17z" fill="#8A8E96"/><rect x="20" y="90" width="16" height="40" fill="#62666D"/></g><g transform="translate(72 0)"><rect x="22" y="6" width="12" height="14" rx="2" fill="#B9BCC3"/><rect x="18" y="20" width="20" height="56" rx="8" fill="#F4F4F5"/><path d="M14 76h28l-3 14H17z" fill="#E1251B"/><rect x="20" y="90" width="16" height="40" fill="#62666D"/></g></svg>
                {%- when 'shock' -%}
                  <svg width="70" height="104" viewBox="0 0 80 200" fill="none" aria-hidden="true"><circle cx="40" cy="14" r="10" stroke="#B9BCC3" stroke-width="5"/><rect x="34" y="24" width="12" height="60" fill="#B9BCC3"/><path d="M14 40 L66 52 L14 64 L66 76 L14 88 L66 100 L14 112 L66 124 L14 136" stroke="#E1251B" stroke-width="6" stroke-linecap="round"/><rect x="24" y="84" width="32" height="96" rx="6" fill="#3A3D44"/><circle cx="40" cy="188" r="9" stroke="#B9BCC3" stroke-width="5"/></svg>
                {%- else -%}
                  <svg width="100" height="100" viewBox="0 0 200 200" fill="none" aria-hidden="true"><circle cx="100" cy="100" r="80" fill="#2A2C31" stroke="#4A4D55" stroke-width="3"/><circle cx="100" cy="100" r="30" fill="#3A3D44"/><path d="M30 60 C18 84 18 116 30 140 L52 130 C44 112 44 88 52 70 Z" fill="#E1251B"/></svg>
              {%- endcase -%}
            {%- endif -%}
          </span>
          <span class="ma-bento__label">{{ label | escape }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Metro category bento",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Everyday essentials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all categories" },
    { "type": "url", "id": "link_url", "label": "Link", "default": "/collections" },
    { "type": "header", "content": "Feature tile" },
    { "type": "text", "id": "feature_eyebrow", "label": "Eyebrow", "default": "Over 7,600 parts in stock" },
    { "type": "text", "id": "feature_title", "label": "Title", "default": "Car parts and accessories" },
    { "type": "text", "id": "feature_text", "label": "Text", "default": "Brakes, filters, fluids, body parts and workshop supplies, matched to your make, model and year." },
    { "type": "url", "id": "feature_url", "label": "Link", "default": "/collections" },
    { "type": "image_picker", "id": "feature_image", "label": "Background image", "info": "Optional. Replaces the illustration." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the collection title. Without a collection, links to /collections/<label as handle>." },
        { "type": "select", "id": "art", "label": "Illustration", "default": "rotor", "options": [
          { "value": "rotor", "label": "Brake rotor" }, { "value": "can", "label": "Aerosol can" },
          { "value": "plug", "label": "Spark plugs" }, { "value": "shock", "label": "Shock absorber" }
        ] },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Transparent PNG works best." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Metro category bento",
      "blocks": [
        { "type": "tile", "settings": { "label": "Brake pads", "art": "rotor" } },
        { "type": "tile", "settings": { "label": "Lubricants and sprays", "art": "can" } },
        { "type": "tile", "settings": { "label": "Ignition system", "art": "plug" } },
        { "type": "tile", "settings": { "label": "Suspension", "art": "shock" } }
      ]
    }
  ]
}
{% endschema %}
