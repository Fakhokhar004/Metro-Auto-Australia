    { "type": "text", "id": "wish_view_label", "label": "View wishlist button", "default": "View wishlist" },
    { "type": "text", "id": "wish_empty_label", "label": "Empty wishlist message", "default": "You have not saved anything yet." },
    { "type": "text", "id": "wish_loading_label", "label": "Loading message", "default": "Loading your saved items..." },
    { "type": "text", "id": "wish_confirm_text", "label": "Clear confirmation message", "default": "Remove everything from your wishlist?" },

    { "type": "header", "content": "Dropdown style (cart + wishlist)" },
    { "type": "range", "id": "drop_width", "label": "Dropdown width", "min": 260, "max": 480, "step": 10, "unit": "px", "default": 360 },
    { "type": "range", "id": "drop_max_height", "label": "List max height (desktop)", "min": 160, "max": 600, "step": 10, "unit": "px", "default": 340 },
