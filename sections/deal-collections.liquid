{{ 'Custom_Deal_collection.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  ============================================================
  METRO AUTO — Deal Collection
  Cards are the SAME ma-* cards as the Search page:
  same shadow card, same 4:3 media, same title / price scale,
  same .ma-wish heart (native wishlist, key 'shopify-wishlist').

  NEW: card footer with a quantity stepper + Add to cart, so a
  shopper can add straight from the row. Toggle both on/off.
  Layout = Carousel (arrows) or Grid.
  ============================================================
{%- endcomment -%}

{%- liquid
  assign sid = section.id

  # ---------- blocks ----------
  assign banner_block = blank
  assign prod_block = blank
  for b in section.blocks
    if b.type == 'banner'
      assign banner_block = b
    endif
    if b.type == 'feature-product'
      assign prod_block = b
    endif
  endfor

  # ---------- layout ----------
  assign is_carousel = false
  if section.settings.layout == 'carousel'
    assign is_carousel = true
  endif

  assign cols_d = section.settings.grid_columns | default: 4
  assign cols_t = section.settings.grid_columns_tablet | default: 3
  assign cols_m = section.settings.grid_columns_mobile | default: 2

  # ---------- card scale follows the desktop column count (same table as Search) ----------
  if cols_d >= 6
    assign t_size = 14
    assign p_size = 15
    assign ty_size = 11
    assign c_pad = 8
    assign c_radius = 12
  elsif cols_d == 5
    assign t_size = 15
    assign p_size = 17
    assign ty_size = 12
    assign c_pad = 10
    assign c_radius = 14
  elsif cols_d == 4
    assign t_size = 17
    assign p_size = 19
    assign ty_size = 13
    assign c_pad = 12
    assign c_radius = 14
  elsif cols_d == 2
    assign t_size = 21
    assign p_size = 23
    assign ty_size = 15
    assign c_pad = 16
    assign c_radius = 18
  elsif cols_d == 1
    assign t_size = 22
    assign p_size = 24
    assign ty_size = 15
    assign c_pad = 18
    assign c_radius = 18
  else
    assign t_size = 19
    assign p_size = 21
    assign ty_size = 14
    assign c_pad = 14
    assign c_radius = 16
  endif

  # ---------- card scale follows the mobile column count ----------
  if cols_m >= 3
    assign t_size_m = 13
    assign p_size_m = 14
    assign ty_size_m = 11
    assign c_pad_m = 6
  elsif cols_m == 1
    assign t_size_m = 18
    assign p_size_m = 20
    assign ty_size_m = 13
    assign c_pad_m = 12
  else
    assign t_size_m = 15
    assign p_size_m = 16
    assign ty_size_m = 12
    assign c_pad_m = 8
  endif

  # ---------- cart state, rendered server side (no flash) ----------
  assign cart_ids = cart.items | map: 'variant_id' | join: ','
  assign cart_ids_padded = ',' | append: cart_ids | append: ','
-%}

<div
  class="product-area feature_deal_collection ma-deal"
  id="section-{{ sid }}"
  data-section="Feature_Collection"
  data-section-id="{{ sid }}"
>
  <div class="{% if section.settings.section_width == 'full_width' %}container-fluid{% elsif section.settings.section_width == 'box_width' %}container-fluid section-padding-1{% else %}container default{% endif %}">
    {% if section.settings.section_title != '' or section.settings.section_sub_title != '' %}
      <div class="section-title {{ section.settings.title_align }} pb-30 {% if settings.section__animation__enable %}scroll-zoom{% endif %}">
        {% if section.settings.section_title != '' %}
          <h2>{{ section.settings.section_title }}</h2>
        {% endif %}
        {% if section.settings.section_sub_title != '' %}
          <p>{{ section.settings.section_sub_title }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.offer_date != '' %}
      <div class="row {% if settings.section__animation__enable %}scroll-zoom{% endif %}">
        <div class="col-lg-8 col-md-10 col-12 ml-auto mr-auto">
          <div class="deal_count_area_wrap">
            <div class="theme-product-countdown-wrap countdown-inner">
              <div class="count-box">
                <div class="theme-product-countdown" data-countdown="{{ section.settings.offer_date }}"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    <div class="ma-deal-layout row {% if settings.section__animation__enable %}scroll-zoom{% endif %}">
      {%- if banner_block != blank -%}
        {%- liquid
          assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
          assign fetch_priority = 'auto'
          if section.index == 1
            assign fetch_priority = 'high'
          endif
        -%}
        <div class="col-md-{{ banner_block.settings.banner_column_handle }} ma-deal-banner-col" {{ banner_block.shopify_attributes }}>
          <div class="single-banner featured_banner border__radius">
            <a
              href="{{ banner_block.settings.featured_banner_url | default: '/collections/all' }}"
              class="lazyload-wraper-position"
              style="padding-top:{{ 1 | divided_by: banner_block.settings.featured_banner.aspect_ratio | times: 100 }}%;"
            >
              {%- if banner_block.settings.featured_banner -%}
                {%- assign image_height = banner_block.settings.featured_banner.width
                  | divided_by: banner_block.settings.featured_banner.aspect_ratio
                -%}
                {{
                  banner_block.settings.featured_banner
                  | image_url: width: 3840
                  | image_tag:
                    width: banner_block.settings.featured_banner.width,
                    height: image_height,
                    widths: widths,
                    fetchpriority: fetch_priority,
                    class: 'lazyload-main-image animated responsive-image__image',
                    loading: 'lazy',
                    alt: banner_block.settings.featured_banner.alt
                }}
              {%- else -%}
                <img loading="lazy" class="animated" src="https://via.placeholder.com/270x450" alt="">
              {%- endif -%}
            </a>
          </div>
        </div>
      {%- endif -%}

      {%- if prod_block != blank -%}
        {%- liquid
          assign col_width = prod_block.settings.feature_column_handle
          if banner_block != blank
            assign col_width = 12 | minus: banner_block.settings.banner_column_handle
          endif
          assign deal_collection = collections[prod_block.settings.featured_product_handle]
          assign product_limit = prod_block.settings.product_limit_handle
        -%}

        <div class="col-md-{{ col_width }} ma-deal-products-col" {{ prod_block.shopify_attributes }}>
          <div
            class="ma-slider{% if is_carousel %} ma-slider--on{% endif %}{% if section.settings.arrow_position == 'outside' %} ma-slider--outside{% endif %}"
            data-ma-slider
            data-step="{{ section.settings.carousel_step }}"
            data-loop="{{ section.settings.carousel_loop }}"
          >
            {%- if is_carousel and section.settings.show_arrows -%}
              <button type="button" class="ma-nav ma-nav--prev" data-ma-prev aria-label="Previous products">
                <svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
            {%- endif -%}

            {%- if deal_collection == empty or deal_collection.products.size == 0 -%}
              <div class="ma-results ma-results--grid">
                {%- for i in (1..product_limit) -%}
                  {% capture ph %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                  <div class="ma-card-wrap">
                    <div class="ma-card">
                      <span class="ma-card__link">
                        <div class="ma-card__media">{{ 'product-' | append: ph | placeholder_svg_tag: 'ma-card__img' }}</div>
                        <div class="ma-card__body">
                          <h3 class="ma-card__title">Product title</h3>
                          <span class="ma-card__price">$99.99</span>
                        </div>
                      </span>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="ma-results ma-results--grid" data-results>
                {%- for product in deal_collection.products limit: product_limit -%}
                  {%- liquid
                    assign v = product.selected_or_first_available_variant
                    assign single_variant = false
                    if product.variants.size == 1
                      assign single_variant = true
                    endif
                    capture needle
                      echo ',' | append: v.id | append: ','
                    endcapture
                    assign in_cart = false
                    if cart_ids_padded contains needle
                      assign in_cart = true
                    endif
                  -%}

                  {%- comment -%} Metro product card (snippets/ma-product-card) {%- endcomment -%}
                  <div class="ma-card-wrap" data-wish-id="{{ product.id }}">
                    {%- render 'ma-product-card', product: product -%}
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if is_carousel and section.settings.show_arrows -%}
              <button type="button" class="ma-nav ma-nav--next" data-ma-next aria-label="Next products">
                <svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            {%- endif -%}
            {%- if is_carousel and section.settings.show_dots -%}
              <div class="ma-dots" data-ma-dots></div>
            {%- endif -%}
          </div>

          {%- if prod_block.settings.button_title != '' -%}
            <div class="show-more-btn text-center mt-10 toggle-btn ma-more">
              <a class="loadMore" href="{{ prod_block.settings.button_url }}">{{ prod_block.settings.button_title }}</a>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- render 'section-style' -%}

<style>
  /* METRO AUTO — deal cards, same visual language as the Search page */
  #section-{{ sid }}{
    --ma-red:{{ section.settings.accent_color | default: '#B91C1C' }};
    --ma-red-dark:{{ section.settings.accent_hover_color | default: '#991b1b' }};
    --ma-ink:#111827;--ma-muted:#6b7280;
    --ma-line:#e5e7eb;--ma-placeholder:#ffffff;
    --ma-card-shadow:0 1px 3px rgba(0,0,0,.06),0 8px 24px rgba(0,0,0,.06);

    --ma-cols-d:{{ cols_d }};
    --ma-cols-t:{{ cols_t }};
    --ma-cols-m:{{ cols_m }};
    --ma-gap-d:{{ section.settings.grid_gap | default: 22 }}px;
    --ma-gap-m:{{ section.settings.grid_gap_mobile | default: 14 }}px;
    --ma-card-pad:{{ c_pad }}px;
    --ma-card-radius:{{ c_radius }}px;
    --ma-card-title:{{ t_size }}px;
    --ma-card-price:{{ p_size }}px;
    --ma-card-type:{{ ty_size }}px;
    --ma-card-ratio:{{ section.settings.card_image_ratio | default: '4 / 3' }};
    --ma-card-fit:{{ section.settings.card_image_fit | default: 'cover' }};
    --ma-arrow:{{ section.settings.arrow_size }}px;
  }

  /* ---------- Grid ---------- */
  #section-{{ sid }} .ma-results--grid{display:grid;grid-template-columns:repeat(var(--ma-cols-d),minmax(0,1fr));gap:var(--ma-gap-d);}
  #section-{{ sid }} .ma-card-wrap{position:relative;display:flex;}
  #section-{{ sid }} .ma-card{display:flex;flex-direction:column;width:100%;background:#fff;border-radius:var(--ma-card-radius);border:none;box-shadow:var(--ma-card-shadow);padding:var(--ma-card-pad);transition:transform .15s,box-shadow .15s;height:100%;}
  #section-{{ sid }} .ma-card:hover{transform:translateY(-3px);box-shadow:0 6px 14px rgba(0,0,0,.08),0 16px 40px rgba(0,0,0,.08);}
  #section-{{ sid }} .ma-card__link{display:flex;flex-direction:column;flex:1 1 auto;text-decoration:none;color:inherit;}
  #section-{{ sid }} .ma-card__media{border-radius:10px;overflow:hidden;background:var(--ma-placeholder);aspect-ratio:var(--ma-card-ratio);}
  #section-{{ sid }} .ma-card__img{width:100%;height:100%;object-fit:var(--ma-card-fit);display:block;}
  #section-{{ sid }} .ma-card__placeholder{width:100%;height:100%;background:var(--ma-placeholder);border-radius:10px;}
  #section-{{ sid }} .ma-card__body{padding:calc(var(--ma-card-pad) * .8) 4px 6px;}
  #section-{{ sid }} .ma-card__type{display:block;font-size:var(--ma-card-type);color:var(--ma-muted);margin-bottom:6px;}
  #section-{{ sid }} .ma-card__title{font-size:var(--ma-card-title);font-weight:800;color:var(--ma-ink);line-height:1.25;margin:0 0 10px;display:-webkit-box;-webkit-line-clamp:{{ section.settings.card_title_lines | default: 2 }};-webkit-box-orient:vertical;overflow:hidden;min-height:2.5em;}
  #section-{{ sid }} .ma-card__price{font-size:var(--ma-card-price);font-weight:800;color:var(--ma-red);}
  #section-{{ sid }} .ma-card__was{font-size:.78em;font-weight:600;color:var(--ma-muted);margin-left:6px;}

  /* ---------- Card footer: quantity + add to cart ---------- */
  #section-{{ sid }} .ma-card__foot{display:flex;align-items:center;gap:{{ section.settings.foot_gap }}px;margin-top:auto;padding:{{ section.settings.foot_gap }}px 4px 2px;}
  #section-{{ sid }} .ma-qty{display:flex;align-items:center;border:1px solid var(--ma-line);border-radius:10px;overflow:hidden;flex:0 0 auto;}
  #section-{{ sid }} .ma-qty__btn{width:{{ section.settings.qty_btn_width }}px;height:{{ section.settings.control_height }}px;border:none;background:#f9fafb;font-size:16px;line-height:1;cursor:pointer;color:var(--ma-ink);padding:0;}
  #section-{{ sid }} .ma-qty__btn:hover{background:#f3f4f6;}
  #section-{{ sid }} .ma-qty__input{width:{{ section.settings.qty_input_width }}px;height:{{ section.settings.control_height }}px;border:none;text-align:center;font-size:14px;-moz-appearance:textfield;background:#fff;color:var(--ma-ink);}
  #section-{{ sid }} .ma-qty__input::-webkit-outer-spin-button,
  #section-{{ sid }} .ma-qty__input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0;}
  #section-{{ sid }} .ma-card__add{flex:1 1 auto;min-width:0;display:inline-flex;align-items:center;justify-content:center;height:{{ section.settings.control_height }}px;background:var(--ma-red);color:#fff;font-weight:700;font-size:{{ section.settings.atc_font_size }}px;border:none;border-radius:10px;padding:0 10px;cursor:pointer;text-align:center;text-decoration:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:.15s;}
  #section-{{ sid }} .ma-card__add:hover{background:var(--ma-red-dark);color:#fff;}
  #section-{{ sid }} .ma-card__add:disabled{background:#d1d5db;cursor:not-allowed;}
  #section-{{ sid }} .ma-card__add.is-added,
  #section-{{ sid }} .ma-card__add.is-added:hover{background:{{ section.settings.atc_added_bg | default: '#9e9e9e' }} !important;color:{{ section.settings.atc_added_color | default: '#ffffff' }} !important;cursor:not-allowed;opacity:1;}
  #section-{{ sid }} .ma-card__add.is-loading{opacity:.7;cursor:progress;}

  /* ---------- Wishlist heart (identical to the Search page) ---------- */
  #section-{{ sid }} .ma-wish{position:absolute;top:{{ section.settings.wishlist_offset }}px;right:{{ section.settings.wishlist_offset }}px;z-index:3;
    width:{{ section.settings.wishlist_btn_size | default: 38 }}px;height:{{ section.settings.wishlist_btn_size | default: 38 }}px;
    display:flex;align-items:center;justify-content:center;padding:0;
    background:{{ section.settings.wishlist_btn_bg | default: '#ffffff' }};
    border:1px solid rgba(0,0,0,.08);
    border-radius:{{ section.settings.wishlist_btn_radius | default: 50 }}px;
    box-shadow:0 1px 5px rgba(0,0,0,.14);cursor:pointer;transition:transform .18s,box-shadow .18s;}
  #section-{{ sid }} .ma-wish:hover{transform:scale(1.08);}
  #section-{{ sid }} .ma-wish__icon{display:flex;align-items:center;justify-content:center;width:100%;height:100%;}
  #section-{{ sid }} .ma-wish svg{width:56%;height:56%;display:block;pointer-events:none;}
  #section-{{ sid }} .ma-wish svg path{fill:none;stroke:{{ section.settings.wishlist_icon_color | default: '#9ca3af' }};stroke-width:2;transition:.2s;}
  #section-{{ sid }} .ma-wish .loading-wishlist,
  #section-{{ sid }} .ma-wish .remove-wishlist{display:none;}
  #section-{{ sid }} .ma-wish.active .add-wishlist,
  #section-{{ sid }} .ma-wish.is-wishlisted .add-wishlist{display:none;}
  #section-{{ sid }} .ma-wish.active .remove-wishlist,
  #section-{{ sid }} .ma-wish.is-wishlisted .remove-wishlist{display:flex;}
  #section-{{ sid }} .ma-wish.active svg path,
  #section-{{ sid }} .ma-wish.is-wishlisted svg path{fill:{{ section.settings.wishlist_active_color | default: '#e60023' }};stroke:{{ section.settings.wishlist_active_color | default: '#e60023' }};}
  #section-{{ sid }} .ma-wish.active,
  #section-{{ sid }} .ma-wish.is-wishlisted{box-shadow:0 0 0 2px {{ section.settings.wishlist_active_color | default: '#e60023' }}22,0 2px 8px rgba(0,0,0,.16);animation:maWishPulse .45s ease;}
  @keyframes maWishPulse{0%{transform:scale(1);}40%{transform:scale(1.25);}100%{transform:scale(1);}}

  /* ---------- Carousel ---------- */
  #section-{{ sid }} .ma-slider{position:relative;}
  {% if section.settings.arrow_position == 'outside' %}
    #section-{{ sid }} .ma-slider--outside{padding:0 calc(var(--ma-arrow) + {{ section.settings.arrow_offset }}px);}
  {% endif %}
  #section-{{ sid }} .ma-slider--on .ma-results--grid{
    grid-template-columns:none;
    grid-auto-flow:column;
    grid-template-rows:repeat({{ section.settings.carousel_rows }},auto);
    grid-auto-columns:calc((100% - (var(--ma-cols-d) - 1) * var(--ma-gap-d)) / var(--ma-cols-d));
    overflow-x:auto;overscroll-behavior-x:contain;
    scroll-snap-type:x mandatory;scroll-behavior:smooth;
    scrollbar-width:none;-ms-overflow-style:none;padding:4px 2px 6px;
  }
  #section-{{ sid }} .ma-slider--on .ma-results--grid::-webkit-scrollbar{display:none;}
  #section-{{ sid }} .ma-slider--on .ma-card-wrap{scroll-snap-align:start;}
  #section-{{ sid }} .ma-nav{position:absolute;top:{{ section.settings.arrow_vertical }}%;transform:translateY(-50%);z-index:6;
    width:var(--ma-arrow);height:var(--ma-arrow);padding:calc(var(--ma-arrow) * .24);
    display:inline-flex;align-items:center;justify-content:center;border:0;cursor:pointer;
    background:{{ section.settings.arrow_bg }};color:{{ section.settings.arrow_color }};
    border-radius:{{ section.settings.arrow_radius }}px;
    {% if section.settings.arrow_shadow %}box-shadow:0 2px 10px rgba(0,0,0,.15);{% endif %}
    transition:background .2s,color .2s,opacity .2s;}
  #section-{{ sid }} .ma-nav:hover{background:{{ section.settings.arrow_hover_bg }};color:{{ section.settings.arrow_hover_color }};}
  #section-{{ sid }} .ma-nav[hidden]{display:none;}
  #section-{{ sid }} .ma-nav.is-disabled{opacity:.35;cursor:default;}
  {% if section.settings.arrow_position == 'outside' %}
    #section-{{ sid }} .ma-nav--prev{left:0;}
    #section-{{ sid }} .ma-nav--next{right:0;}
  {% else %}
    #section-{{ sid }} .ma-nav--prev{left:{{ section.settings.arrow_offset }}px;}
    #section-{{ sid }} .ma-nav--next{right:{{ section.settings.arrow_offset }}px;}
  {% endif %}
  #section-{{ sid }} .ma-dots{display:flex;justify-content:center;gap:{{ section.settings.dot_gap }}px;margin-top:{{ section.settings.dot_margin_top }}px;}
  #section-{{ sid }} .ma-dots button{border:0;padding:0;cursor:pointer;width:{{ section.settings.dot_size }}px;height:{{ section.settings.dot_size }}px;border-radius:50%;background:{{ section.settings.dot_color }};transition:background .2s,transform .2s;}
  #section-{{ sid }} .ma-dots button.is-active{background:{{ section.settings.dot_active_color }};transform:scale(1.25);}

  /* ---------- Tablet ---------- */
  @media (max-width:1024px){
    #section-{{ sid }} .ma-results--grid{grid-template-columns:repeat(var(--ma-cols-t),minmax(0,1fr));}
    #section-{{ sid }} .ma-slider--on .ma-results--grid{
      grid-template-columns:none;
      grid-auto-columns:calc((100% - (var(--ma-cols-t) - 1) * var(--ma-gap-d)) / var(--ma-cols-t));
    }
  }

  /* ---------- Phone ---------- */
  @media (max-width:767px){
    #section-{{ sid }}{
      --ma-card-pad:{{ c_pad_m }}px;
      --ma-card-title:{{ t_size_m }}px;
      --ma-card-price:{{ p_size_m }}px;
      --ma-card-type:{{ ty_size_m }}px;
      --ma-arrow:{{ section.settings.arrow_size_mobile }}px;
    }
    #section-{{ sid }} .ma-results--grid{grid-template-columns:repeat(var(--ma-cols-m),minmax(0,1fr));gap:var(--ma-gap-m);}
    #section-{{ sid }} .ma-slider--on .ma-results--grid{
      grid-template-columns:none;
      grid-auto-columns:calc((100% - (var(--ma-cols-m) - 1) * var(--ma-gap-m)) / var(--ma-cols-m));
    }
    #section-{{ sid }} .ma-card{border-radius:calc(var(--ma-card-radius) - 2px);}
    #section-{{ sid }} .ma-card__body{padding:calc(var(--ma-card-pad) * .9) 2px 4px;}
    #section-{{ sid }} .ma-card__title{margin-bottom:6px;min-height:2.4em;}
    #section-{{ sid }} .ma-card__foot{gap:6px;}
    #section-{{ sid }} .ma-card__add{font-size:{{ section.settings.atc_font_size_mobile }}px;height:{{ section.settings.control_height_mobile }}px;padding:0 6px;}
    #section-{{ sid }} .ma-qty__btn{width:{{ section.settings.qty_btn_width | times: 0.8 | round }}px;height:{{ section.settings.control_height_mobile }}px;}
    #section-{{ sid }} .ma-qty__input{width:{{ section.settings.qty_input_width | times: 0.72 | round }}px;height:{{ section.settings.control_height_mobile }}px;font-size:13px;}
    {% unless section.settings.show_qty_mobile %}
      #section-{{ sid }} .ma-card__foot .ma-qty{display:none;}
    {% endunless %}
    #section-{{ sid }} .ma-wish{width:{{ section.settings.wishlist_btn_size | times: 0.85 | round }}px;height:{{ section.settings.wishlist_btn_size | times: 0.85 | round }}px;top:8px;right:8px;}
    {% unless section.settings.arrows_mobile %}
      #section-{{ sid }} .ma-nav{display:none !important;}
      #section-{{ sid }} .ma-slider--outside{padding:0;}
    {% endunless %}
    {% if section.settings.stack_banner_mobile %}
      #section-{{ sid }} .ma-deal-banner-col{margin-bottom:20px;}
    {% endif %}
  }

  @media (prefers-reduced-motion: reduce){
    #section-{{ sid }} .ma-card,
    #section-{{ sid }} .ma-wish{transition:none !important;animation:none !important;}
    #section-{{ sid }} .ma-slider--on .ma-results--grid{scroll-behavior:auto;}
  }
</style>

{% if section.settings.section_title_custom_color %}
  <style>
    {%- assign section_title_font = section.settings.section_title_font -%}
    {%- assign section_sub_title_font = section.settings.section_sub_title_font -%}
    {{ section_title_font | font_face }}
    {{ section_sub_title_font | font_face }}

    #section-{{ sid }} .section-title h2{
      font-family: {{ section_title_font.family }}, {{ section_title_font.fallback_families }};
      font-style: {{ section_title_font.style }};
      font-weight: {{ section_title_font.weight }};
      color: {{ section.settings.section_title_color }};
      font-size:{{ section.settings.section_title_font_size }}px;
      line-height: {{ section.settings.section_title_line_height }}px;
