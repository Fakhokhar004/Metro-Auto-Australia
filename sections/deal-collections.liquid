<script>
(function () {
  var root = document.getElementById('section-{{ sid }}');
  if (!root) return;

  /* ---------- Quantity steppers ---------- */
  root.querySelectorAll('[data-qty]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var input = btn.parentNode.querySelector('.ma-qty__input');
      if (!input) return;
      var next = (parseInt(input.value, 10) || 1) + parseInt(btn.getAttribute('data-qty'), 10);
      input.value = next < 1 ? 1 : next;
    });
  });
  root.querySelectorAll('.ma-qty__input').forEach(function (input) {
    input.addEventListener('change', function () {
      var v = parseInt(input.value, 10);
      if (!v || v < 1) input.value = 1;
    });
  });

  /* ---------- Add to cart: AJAX + grey "added" state ---------- */
  function qtyFor(btn) {
    var foot = btn.closest('.ma-card__foot');
    var input = foot ? foot.querySelector('.ma-qty__input') : null;
    var v = input ? parseInt(input.value, 10) : 1;
    return (v && v > 0) ? v : 1;
  }
  function labelEl(btn) { return btn.querySelector('.ma-add-text') || btn; }
  function markAdded(btn, line_item) {
    labelEl(btn).textContent = btn.getAttribute('data-added-text') || 'Added to cart';
    btn.classList.remove('is-loading');
    btn.classList.add('is-added');
    btn.disabled = true;
    if (window.Shopify && typeof window.Shopify.onItemAdded === 'function' && line_item) {
      try { window.Shopify.onItemAdded(line_item); } catch (err) {}
    }
  }
  function clearAdded(btn) {
    labelEl(btn).textContent = btn.getAttribute('data-default-text') || 'Add to cart';
    btn.classList.remove('is-added', 'is-loading');
    btn.disabled = false;
  }

  root.querySelectorAll('[data-add-to-cart]').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      if (btn.disabled || btn.classList.contains('is-added')) return;
      var id = btn.getAttribute('data-variant-id');
      if (!id) return;
      var qty = qtyFor(btn);
      btn.classList.add('is-loading');
      if (window.Shopify && typeof window.Shopify.addItem === 'function') {
        window.Shopify.addItem(id, qty, function (li) { markAdded(btn, li); });
      } else {
        fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id, quantity: qty }), credentials: 'same-origin' })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (li) { btn.classList.remove('is-loading'); if (li) markAdded(btn, li); })
          .catch(function () { btn.classList.remove('is-loading'); });
      }
    });
  });

  /* keeps the buttons honest: re-reads the real cart on load and on return */
  function syncFromCart() {
    fetch('/cart.js', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (c) {
        if (!c || !c.items) return;
        var ids = {};
        c.items.forEach(function (i) { ids[String(i.variant_id)] = true; });
        root.querySelectorAll('[data-add-to-cart]').forEach(function (b) {
          if (ids[String(b.getAttribute('data-variant-id'))]) { markAdded(b); } else { clearAdded(b); }
        });
      })
      .catch(function () {});
  }

  /* ---------- Wishlist: native theme wishlist (key 'shopify-wishlist', handles) ---------- */
  var WKEY = 'shopify-wishlist';
  function wRead() {
    var raw = '';
    try { raw = localStorage.getItem(WKEY) || ''; } catch (e) {}
    return raw.split(',').filter(function (h) { return h && h.trim() !== ''; });
  }
  function wWrite(list) { try { localStorage.setItem(WKEY, list.join(',')); } catch (e) {} }
  function wSync() {
    var list = wRead();
    root.querySelectorAll('[button-wishlist]').forEach(function (btn) {
      btn.classList.toggle('active', list.indexOf(btn.getAttribute('data-product-handle')) > -1);
    });
  }
  root.querySelectorAll('[button-wishlist]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (window.ThemeWishlist || typeof window.updateWishlist === 'function') {
        setTimeout(wSync, 60);   // let the native script write, then re-sync every heart
        return;
      }
      var h = btn.getAttribute('data-product-handle');
      if (!h) return;
      var list = wRead();
      var i = list.indexOf(h);
      if (i > -1) { list.splice(i, 1); } else { list.push(h); }
      wWrite(list);
      wSync();
    });
  });
  window.addEventListener('storage', function (e) { if (e.key === WKEY) wSync(); });
  window.addEventListener('pageshow', function (e) { if (e.persisted) { wSync(); syncFromCart(); } });

  /* ---------- Carousel ---------- */
  (function initSlider() {
    var slider = root.querySelector('[data-ma-slider]');
    if (!slider || !slider.classList.contains('ma-slider--on')) return;
    var track = slider.querySelector('.ma-results--grid');
    if (!track) return;

    var prev = slider.querySelector('[data-ma-prev]');
    var next = slider.querySelector('[data-ma-next]');
    var dots = slider.querySelector('[data-ma-dots]');
    var loop = slider.getAttribute('data-loop') === 'true';
    var byPage = slider.getAttribute('data-step') === 'page';

    function stepSize() {
      if (byPage) return track.clientWidth;
      var card = track.querySelector('.ma-card-wrap');
      if (!card) return track.clientWidth;
      var cs = getComputedStyle(track);
      var gap = parseFloat(cs.columnGap || cs.gap || '0') || 0;
      return card.getBoundingClientRect().width + gap;
    }
    function maxScroll() { return track.scrollWidth - track.clientWidth; }

    function go(dir) {
      var max = maxScroll();
      var target = track.scrollLeft + dir * stepSize();
      if (loop) {
        if (dir > 0 && track.scrollLeft >= max - 2) target = 0;
        if (dir < 0 && track.scrollLeft <= 2) target = max;
      }
      track.scrollTo({ left: Math.max(0, Math.min(target, max)), behavior: 'smooth' });
    }
    function buildDots() {
      if (!dots) return;
      var pages = Math.max(1, Math.ceil(track.scrollWidth / Math.max(1, track.clientWidth)));
      if (dots.childElementCount === pages) return;
      dots.innerHTML = '';
      for (var i = 0; i < pages; i++) {
        var b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-label', 'Go to page ' + (i + 1));
        b.dataset.page = i;
        dots.appendChild(b);
      }
    }
    function update() {
      var can = maxScroll() > 2;
      if (prev) prev.hidden = !can;
      if (next) next.hidden = !can;
      if (dots) dots.hidden = !can;
      if (!can) return;
      var max = maxScroll();
      if (!loop) {
        if (prev) prev.classList.toggle('is-disabled', track.scrollLeft <= 2);
        if (next) next.classList.toggle('is-disabled', track.scrollLeft >= max - 2);
      }
      buildDots();
      if (dots && dots.children.length) {
        var active = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
        Array.prototype.forEach.call(dots.children, function (d, i) { d.classList.toggle('is-active', i === active); });
      }
    }

    if (prev) prev.addEventListener('click', function () { go(-1); });
    if (next) next.addEventListener('click', function () { go(1); });
    if (dots) dots.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-page]');
      if (b) track.scrollTo({ left: b.dataset.page * track.clientWidth, behavior: 'smooth' });
    });

    var ticking = false;
    track.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { update(); ticking = false; });
    });
    if (window.ResizeObserver) { new ResizeObserver(update).observe(track); }
    else { window.addEventListener('resize', update); }

    update();
    setTimeout(update, 300);
  })();

  wSync();
  syncFromCart();

  if (window.Shopify && Shopify.designMode) {
    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId === '{{ sid }}') { wSync(); syncFromCart(); }
    });
  }
})();
</script>

