{%- comment -%}
  ============================================================================
  COLLECTION LIST / INDEX  —  card grid (image + name only)   v3
  Metro Auto Australia

  Scope: the COLLECTION LIST page only (templates/list-collections.*).
  The individual collection page (Custom_Collection_Template / main-collection)
  is untouched — it keeps its product grid, filters, wishlist and cart.

  v3 changes:
    - Image area background now defaults to white, and there's a "match the
      card background" option so no grey box sits behind logo PNGs.
    - Tighter default spacing throughout: smaller gaps, smaller card padding,
      smaller image padding. All still adjustable.
    - New toolbar at the top: sort (A–Z, Z–A, most/fewest products, manual),
      a live name search, and an optional A–Z letter filter. Vanilla JS,
      no libraries, degrades to a plain grid if JS is off.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign ratio = s.image_ratio | default: 100

  assign lift_title = s.hover_lift_title
  assign lift_cta = s.hover_lift_cta
  if s.hover_effect == 'fade_only' or s.hover_effect == 'name_only' or s.hover_effect == 'none'
    assign lift_title = 0
    assign lift_cta = 0
  endif

  assign media_bg = s.image_bg
  if s.image_bg_mode == 'card'
    assign media_bg = s.card_bg
  elsif s.image_bg_mode == 'transparent'
    assign media_bg = 'transparent'
  endif

  assign show_toolbar = false
  if s.show_sort or s.show_search or s.show_alpha
    assign show_toolbar = true
  endif
-%}

<style>
  #ma-cl-{{ uid }}{
    --macl-min: {{ s.card_min_width }}px;
    --macl-max: {% if s.card_max_width > 0 %}{{ s.card_max_width }}px{% else %}none{% endif %};
    --macl-gap: {{ s.grid_gap }}px;
    --macl-gap-m: {{ s.grid_gap_mobile }}px;
    --macl-radius: {{ s.card_radius }}px;
    --macl-border: {{ s.border_color }};
    --macl-border-hover: {{ s.border_color_hover }};
    --macl-bg: {{ s.card_bg }};
    --macl-bg-hover: {{ s.card_bg_hover }};
    --macl-media-bg: {{ media_bg }};
    --macl-title: {{ s.title_color }};
    --macl-title-hover: {{ s.title_hover_color }};
    --macl-cta: {{ s.cta_color }};
    --macl-lift-title: {{ lift_title }}px;
    --macl-lift-cta: {{ lift_cta }}px;
    --macl-speed: {{ s.transition_speed }}ms;
    --macl-accent: {{ s.toolbar_accent }};
  }

  #ma-cl-{{ uid }} .ma-cl__head{
    margin: 0 0 {{ s.heading_margin_bottom }}px;
    text-align: {{ s.text_align }};
  }
  #ma-cl-{{ uid }} .ma-cl__head h2{
    margin: 0;
    color: {{ s.heading_color }};
    font-size: {{ s.heading_size }}px;
    line-height: 1.25;
  }
  #ma-cl-{{ uid }} .ma-cl__head p{
    margin: 8px 0 0;
    color: {{ s.subheading_color }};
    font-size: {{ s.subheading_size }}px;
  }

  /* ---- toolbar -------------------------------------------------------- */
  #ma-cl-{{ uid }} .ma-cl__toolbar{
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: {% if s.toolbar_align == 'left' %}flex-start{% elsif s.toolbar_align == 'right' %}flex-end{% else %}space-between{% endif %};
    gap: 10px;
    margin: 0 0 {{ s.toolbar_margin_bottom }}px;
    padding-bottom: {% if s.toolbar_divider %}10px{% else %}0{% endif %};
    {% if s.toolbar_divider %}border-bottom: 1px solid {{ s.border_color }};{% endif %}
  }
  #ma-cl-{{ uid }} .ma-cl__tools{
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  #ma-cl-{{ uid }} .ma-cl__search,
  #ma-cl-{{ uid }} .ma-cl__sort{
    height: {{ s.toolbar_height }}px;
    padding: 0 10px;
    border: 1px solid {{ s.border_color }};
    border-radius: {{ s.toolbar_radius }}px;
    background: #fff;
    color: {{ s.title_color }};
    font-size: {{ s.toolbar_font_size }}px;
    line-height: 1.2;
    outline: none;
    transition: border-color var(--macl-speed) ease;
  }
  #ma-cl-{{ uid }} .ma-cl__search{ width: {{ s.search_width }}px; max-width: 100%; }
  #ma-cl-{{ uid }} .ma-cl__sort{ padding-right: 26px; cursor: pointer; }
  #ma-cl-{{ uid }} .ma-cl__search:focus,
  #ma-cl-{{ uid }} .ma-cl__sort:focus{ border-color: var(--macl-accent); }
  #ma-cl-{{ uid }} .ma-cl__count{
    color: {{ s.subheading_color }};
    font-size: {{ s.toolbar_font_size }}px;
  }

  #ma-cl-{{ uid }} .ma-cl__alpha{
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    width: 100%;
    margin-top: 2px;
  }
  #ma-cl-{{ uid }} .ma-cl__letter{
    min-width: {{ s.toolbar_height | minus: 6 }}px;
    height: {{ s.toolbar_height | minus: 6 }}px;
    padding: 0 6px;
    border: 1px solid {{ s.border_color }};
    border-radius: {{ s.toolbar_radius }}px;
    background: #fff;
    color: {{ s.title_color }};
    font-size: {{ s.toolbar_font_size | minus: 1 }}px;
    line-height: 1;
    cursor: pointer;
    transition: all var(--macl-speed) ease;
  }
  #ma-cl-{{ uid }} .ma-cl__letter:hover{ border-color: var(--macl-accent); color: var(--macl-accent); }
  #ma-cl-{{ uid }} .ma-cl__letter.is-active{
    background: var(--macl-accent);
    border-color: var(--macl-accent);
    color: #fff;
  }

  /* ---- grid ---------------------------------------------------------- */
  #ma-cl-{{ uid }} .ma-cl__grid{
    display: grid;
    /* auto-fill keeps the empty columns reserved, so filtering down to two
       results leaves two normal-sized cards instead of two giant ones.
       auto-fit (the "Stretch" option) collapses them and lets cards grow. */
    grid-template-columns: repeat({% if s.grid_mode == 'stretch' %}auto-fit{% else %}auto-fill{% endif %}, minmax(var(--macl-min), 1fr));
    gap: var(--macl-gap);
    justify-content: {% if s.grid_align == 'center' %}center{% else %}start{% endif %};
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* hard ceiling on a single card, whatever the grid does */
  #ma-cl-{{ uid }} .ma-cl__item{
    width: 100%;
    max-width: var(--macl-max);
    {% if s.grid_align == 'center' %}margin-inline: auto;{% endif %}
  }
  #ma-cl-{{ uid }} .ma-cl__item.is-hidden{ display: none; }
  #ma-cl-{{ uid }} .ma-cl__empty{
    display: none;
    padding: 30px 0;
    color: {{ s.subheading_color }};
    font-size: 14px;
    text-align: center;
  }
  #ma-cl-{{ uid }}.is-empty .ma-cl__empty{ display: block; }

  /* ---- card = ONE link, nothing nested inside it ---------------------- */
  #ma-cl-{{ uid }} .ma-cl__card{
    position: relative;
    display: block;
    height: 100%;
    text-decoration: none;
    background: var(--macl-bg);
    border: {{ s.border_width }}px solid var(--macl-border);
    border-radius: var(--macl-radius);
    overflow: hidden;
    transition: border-color var(--macl-speed) ease,
                background-color var(--macl-speed) ease,
                box-shadow var(--macl-speed) ease,
                transform var(--macl-speed) ease;
  }
  #ma-cl-{{ uid }} .ma-cl__card:hover,
  #ma-cl-{{ uid }} .ma-cl__card:focus-visible{
    border-color: var(--macl-border-hover);
    background: var(--macl-bg-hover);
    {% if s.card_shadow_hover %}box-shadow: 0 4px 14px rgba(0,0,0,.09);{% endif %}
    {% if s.card_raise %}transform: translateY(-2px);{% endif %}
  }
  #ma-cl-{{ uid }} .ma-cl__card:focus-visible{
    outline: 2px solid var(--macl-border-hover);
    outline-offset: 2px;
  }

  /* ---- media ---------------------------------------------------------- */
  #ma-cl-{{ uid }} .ma-cl__media{
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 100 / {{ ratio }};
    background: var(--macl-media-bg);
    overflow: hidden;
  }
  @supports not (aspect-ratio: 1 / 1){
    #ma-cl-{{ uid }} .ma-cl__media{ height: 0; padding-bottom: {{ ratio }}%; }
  }
  #ma-cl-{{ uid }} .ma-cl__media img,
  #ma-cl-{{ uid }} .ma-cl__media svg{
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ s.image_fit }};
    {% if s.image_fit == 'contain' %}padding: {{ s.image_padding }}px;{% endif %}
    transition: transform var(--macl-speed) ease;
  }
  {% if s.image_zoom %}
  #ma-cl-{{ uid }} .ma-cl__card:hover .ma-cl__media img{ transform: scale(1.05); }
  {% endif %}

  /* ---- body ----------------------------------------------------------- */
  #ma-cl-{{ uid }} .ma-cl__body{
    display: block;
    padding: {{ s.body_padding_top }}px {{ s.body_padding_side }}px {{ s.body_padding_bottom }}px;
    text-align: {{ s.card_text_align }};
    overflow: hidden;
  }
  #ma-cl-{{ uid }} .ma-cl__title{
    display: block;
    margin: 0;
    color: var(--macl-title);
    font-size: {{ s.title_size }}px;
    font-weight: {{ s.title_weight }};
    line-height: {{ s.title_line_height }};
    {% if s.title_uppercase %}text-transform: uppercase; letter-spacing: .02em;{% endif %}
    {% if s.title_lines > 0 %}
      display: -webkit-box;
      -webkit-line-clamp: {{ s.title_lines }};
      -webkit-box-orient: vertical;
      overflow: hidden;
    {% endif %}
    transform: translateY(0);
    transition: transform var(--macl-speed) ease, color var(--macl-speed) ease;
  }

  {%- if s.hover_effect != 'name_only' and s.hover_effect != 'none' -%}
  #ma-cl-{{ uid }} .ma-cl__cta{
    display: block;
    margin-top: {{ s.cta_gap }}px;
    color: var(--macl-cta);
    font-size: {{ s.cta_size }}px;
    font-weight: {{ s.cta_weight }};
    line-height: 1.3;
    white-space: nowrap;
    opacity: {% if s.cta_always_visible %}1{% else %}0{% endif %};
    transform: translateY(0);
    transition: opacity var(--macl-speed) ease, transform var(--macl-speed) ease;
  }
  #ma-cl-{{ uid }} .ma-cl__card:hover .ma-cl__cta,
  #ma-cl-{{ uid }} .ma-cl__card:focus-visible .ma-cl__cta{
    opacity: 1;
    transform: translateY(calc(var(--macl-lift-cta) * -1));
  }
  {%- endif -%}

  {%- if s.hover_effect == 'lift_and_fade' -%}
  #ma-cl-{{ uid }} .ma-cl__card:hover .ma-cl__title,
  #ma-cl-{{ uid }} .ma-cl__card:focus-visible .ma-cl__title{
    transform: translateY(calc(var(--macl-lift-title) * -1));
  }
  {%- endif -%}

  {%- if s.title_hover_color_enable -%}
  #ma-cl-{{ uid }} .ma-cl__card:hover .ma-cl__title,
  #ma-cl-{{ uid }} .ma-cl__card:focus-visible .ma-cl__title{
    color: var(--macl-title-hover);
  }
  {%- endif -%}

  /* ---- debug badge (theme editor only) -------------------------------- */
  #ma-cl-{{ uid }} .ma-cl__debug{
    position: absolute;
    top: 6px; left: 6px;
    z-index: 2;
    padding: 2px 6px;
    border-radius: 3px;
    background: rgba(0,0,0,.72);
    color: #fff;
    font-size: 10px;
    line-height: 1.5;
    pointer-events: none;
  }
  #ma-cl-{{ uid }} .ma-cl__debug--warn{ background: rgba(185,28,28,.85); }

  /* ---- mobile --------------------------------------------------------- */
  @media (max-width: 767px){
    #ma-cl-{{ uid }}{
      --macl-min: {{ s.card_min_width_mobile }}px;
      --macl-max: {% if s.card_max_width_mobile > 0 %}{{ s.card_max_width_mobile }}px{% else %}none{% endif %};
      --macl-lift-title: {{ s.hover_lift_mobile }}px;
      --macl-lift-cta: {{ s.hover_lift_mobile }}px;
    }
    #ma-cl-{{ uid }} .ma-cl__grid{ gap: var(--macl-gap-m); }
    #ma-cl-{{ uid }} .ma-cl__title{ font-size: {{ s.title_size_mobile }}px; }
    #ma-cl-{{ uid }} .ma-cl__cta{ font-size: {{ s.cta_size_mobile }}px; }
    #ma-cl-{{ uid }} .ma-cl__head h2{ font-size: {{ s.heading_size_mobile }}px; }
    #ma-cl-{{ uid }} .ma-cl__body{
      padding: {{ s.body_padding_top_mobile }}px {{ s.body_padding_side }}px {{ s.body_padding_bottom_mobile }}px;
    }
    #ma-cl-{{ uid }} .ma-cl__toolbar{ justify-content: flex-start; }
    #ma-cl-{{ uid }} .ma-cl__tools{ width: 100%; }
    #ma-cl-{{ uid }} .ma-cl__search{ flex: 1 1 auto; width: auto; }
    #ma-cl-{{ uid }} .ma-cl__count{ display: none; }
    {%- if s.alpha_hide_mobile -%}
    #ma-cl-{{ uid }} .ma-cl__alpha{ display: none; }
    {%- endif -%}
  }

  @media (hover: none){
    {%- if s.mobile_show_cta -%}
    #ma-cl-{{ uid }} .ma-cl__cta{ opacity: 1; }
    {%- else -%}
    #ma-cl-{{ uid }} .ma-cl__cta{ display: none; }
    {%- endif -%}
    #ma-cl-{{ uid }} .ma-cl__title,
    #ma-cl-{{ uid }} .ma-cl__cta{ transform: none !important; }
  }

  @media (prefers-reduced-motion: reduce){
    #ma-cl-{{ uid }} .ma-cl__card,
    #ma-cl-{{ uid }} .ma-cl__card *{ transition: none !important; }
    #ma-cl-{{ uid }} .ma-cl__title,
    #ma-cl-{{ uid }} .ma-cl__cta{ transform: none !important; }
  }
</style>

<div
  id="ma-cl-{{ uid }}"
  class="ma-cl list-collections-index {% if settings.breadcrumb_banner_enable %}pt-100 pt-sm-70{% endif %} pb-50 pb-sm-20"
  data-section-id="{{ uid }}"
  data-section-type="collection-list">

  <div class="container">

    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="ma-cl__head">
        {%- if s.heading != blank -%}<h2>{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p>{{ s.subheading | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_toolbar -%}
      <div class="ma-cl__toolbar">
        <div class="ma-cl__tools">
          {%- if s.show_search -%}
            <input
              type="search"
              class="ma-cl__search"
              data-search
              placeholder="{{ s.search_placeholder | escape }}"
              aria-label="{{ s.search_placeholder | escape }}"
              autocomplete="off">
          {%- endif -%}

          {%- if s.show_sort -%}
            <select class="ma-cl__sort" data-sort aria-label="{{ s.sort_label | escape }}">
              <option value="alpha_asc">{{ s.label_alpha_asc }}</option>
              <option value="alpha_desc">{{ s.label_alpha_desc }}</option>
              {%- if s.sort_show_count -%}
                <option value="count_desc">{{ s.label_count_desc }}</option>
                <option value="count_asc">{{ s.label_count_asc }}</option>
              {%- endif -%}
              {%- if s.sort_show_manual -%}
                <option value="manual">{{ s.label_manual }}</option>
              {%- endif -%}
            </select>
          {%- endif -%}
        </div>

        {%- if s.show_result_count -%}
          <span class="ma-cl__count" data-count-label></span>
        {%- endif -%}

        {%- if s.show_alpha -%}
          <div class="ma-cl__alpha" data-alpha role="group" aria-label="Filter by first letter"></div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="ma-cl__grid" data-grid role="list">

      {%- if s.collection_source == 'selected' -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'custom_collection' -%}
            {%- assign coll = collections[block.settings.featured_product_handle] -%}
            {%- if coll.handle != blank -%}

              {%- liquid
                assign img = nil
                assign img_src = 'none'
                if block.settings.custom_collection_img.src != blank
                  assign img = block.settings.custom_collection_img
                  assign img_src = 'block override'
                elsif coll.image.src != blank
                  assign img = coll.image
                  assign img_src = 'collection image'
                elsif s.image_fallback == 'featured' and coll.featured_image.src != blank
                  assign img = coll.featured_image
                  assign img_src = 'featured_image'
                elsif s.image_fallback == 'product' and coll.products.first.featured_image.src != blank
                  assign img = coll.products.first.featured_image
                  assign img_src = 'first product'
                endif

                assign card_title = coll.title
                if block.settings.custom_collection_title != blank
                  assign card_title = block.settings.custom_collection_title
                endif
              -%}

              <li
                class="ma-cl__item"
                data-title="{{ card_title | escape }}"
                data-count="{{ coll.all_products_count }}"
                {{ block.shopify_attributes }}>
                <a class="ma-cl__card" href="{{ coll.url }}">
                  {%- if request.design_mode and s.debug_image_source -%}
                    <span class="ma-cl__debug {% if img_src == 'none' %}ma-cl__debug--warn{% endif %}">{{ img_src }}</span>
                  {%- endif -%}
                  <span class="ma-cl__media">
                    {%- if img != nil -%}
                      <img
                        src="{{ img | image_url: width: 600 }}"
                        srcset="{{ img | image_url: width: 300 }} 300w,
                                {{ img | image_url: width: 450 }} 450w,
                                {{ img | image_url: width: 600 }} 600w"
                        sizes="(max-width: 767px) 45vw, {{ s.card_min_width }}px"
                        width="{{ img.width | default: 600 }}"
                        height="{{ img.height | default: 600 }}"
                        alt="{{ img.alt | default: card_title | escape }}"
                        loading="lazy">
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag: 'ma-cl__placeholder' }}
                    {%- endif -%}
                  </span>
                  <span class="ma-cl__body">
                    <span class="ma-cl__title">{{ card_title | escape }}</span>
                    {%- if s.hover_effect != 'name_only' and s.hover_effect != 'none' -%}
                      <span class="ma-cl__cta" aria-hidden="true">{{ s.cta_text }}</span>
                    {%- endif -%}
                  </span>
                </a>
              </li>

            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

      {%- else -%}

        {%- assign shown = 0 -%}

        {%- for coll in collections -%}
          {%- unless coll.handle == 'frontpage' or coll.handle == 'all' -%}
            {%- if shown < s.collections_limit -%}
              {%- if s.hide_empty == false or coll.all_products_count > 0 -%}

                {%- liquid
                  assign shown = shown | plus: 1
                  assign img = nil
                  assign img_src = 'none'
                  if coll.image.src != blank
                    assign img = coll.image
                    assign img_src = 'collection image'
                  elsif s.image_fallback == 'featured' and coll.featured_image.src != blank
                    assign img = coll.featured_image
                    assign img_src = 'featured_image'
                  elsif s.image_fallback == 'product' and coll.products.first.featured_image.src != blank
                    assign img = coll.products.first.featured_image
                    assign img_src = 'first product'
                  endif
                -%}

                <li
                  class="ma-cl__item"
                  data-title="{{ coll.title | escape }}"
                  data-count="{{ coll.all_products_count }}">
                  <a class="ma-cl__card" href="{{ coll.url }}">
                    {%- if request.design_mode and s.debug_image_source -%}
                      <span class="ma-cl__debug {% if img_src == 'none' %}ma-cl__debug--warn{% endif %}">{{ img_src }}</span>
                    {%- endif -%}
                    <span class="ma-cl__media">
                      {%- if img != nil -%}
                        <img
                          src="{{ img | image_url: width: 600 }}"
                          srcset="{{ img | image_url: width: 300 }} 300w,
                                  {{ img | image_url: width: 450 }} 450w,
                                  {{ img | image_url: width: 600 }} 600w"
                          sizes="(max-width: 767px) 45vw, {{ s.card_min_width }}px"
                          width="{{ img.width | default: 600 }}"
                          height="{{ img.height | default: 600 }}"
                          alt="{{ img.alt | default: coll.title | escape }}"
                          loading="lazy">
                      {%- else -%}
                        {{ 'collection-1' | placeholder_svg_tag: 'ma-cl__placeholder' }}
                      {%- endif -%}
                    </span>
                    <span class="ma-cl__body">
                      <span class="ma-cl__title">{{ coll.title | escape }}</span>
                      {%- if s.hover_effect != 'name_only' and s.hover_effect != 'none' -%}
                        <span class="ma-cl__cta" aria-hidden="true">{{ s.cta_text }}</span>
                      {%- endif -%}
                    </span>
                  </a>
                </li>

              {%- endif -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}

      {%- endif -%}

    </ul>

    {%- if show_toolbar -%}
      <p class="ma-cl__empty">{{ s.empty_text }}</p>
    {%- endif -%}

  </div>
</div>

{%- if show_toolbar -%}
<script>
(function(){
  var root = document.getElementById('ma-cl-{{ uid }}');
  if (!root) return;

  var grid = root.querySelector('[data-grid]');
  if (!grid) return;

  var searchEl = root.querySelector('[data-search]');
  var sortEl   = root.querySelector('[data-sort]');
  var alphaEl  = root.querySelector('[data-alpha]');
  var countEl  = root.querySelector('[data-count-label]');

  var items = Array.prototype.slice.call(grid.querySelectorAll('.ma-cl__item'));
  if (!items.length) return;

  // remember the order the page rendered in, for "manual"
  items.forEach(function(el, i){ el._maclIndex = i; });

  var ALL = '{{ s.alpha_all_label | escape }}';
  var state = { q: '', letter: ALL, sort: '{{ s.default_sort }}' };

  function titleOf(el){ return (el.getAttribute('data-title') || '').trim(); }
  function countOf(el){ return parseInt(el.getAttribute('data-count') || '0', 10); }
  function firstLetter(el){
    var t = titleOf(el).replace(/^[^a-z0-9]+/i, '');
    var c = t.charAt(0).toUpperCase();
    return /[A-Z]/.test(c) ? c : '#';
  }

  function buildAlpha(){
    if (!alphaEl) return;
    var seen = {};
    items.forEach(function(el){ seen[firstLetter(el)] = true; });
    var letters = Object.keys(seen).sort(function(a,b){
      if (a === '#') return 1;
      if (b === '#') return -1;
      return a.localeCompare(b);
    });
    var frag = document.createDocumentFragment();
    [ALL].concat(letters).forEach(function(l){
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'ma-cl__letter' + (l === ALL ? ' is-active' : '');
      b.textContent = l;
      b.setAttribute('data-letter', l);
      frag.appendChild(b);
    });
    alphaEl.appendChild(frag);

    alphaEl.addEventListener('click', function(e){
      var btn = e.target.closest('.ma-cl__letter');
      if (!btn) return;
      state.letter = btn.getAttribute('data-letter');
      alphaEl.querySelectorAll('.ma-cl__letter').forEach(function(x){
        x.classList.toggle('is-active', x === btn);
      });
      apply();
    });
  }

  function sortItems(){
    var mode = state.sort;
    var sorted = items.slice().sort(function(a, b){
      switch (mode) {
        case 'alpha_desc': return titleOf(b).localeCompare(titleOf(a), undefined, {sensitivity:'base'});
        case 'count_desc': return countOf(b) - countOf(a) || titleOf(a).localeCompare(titleOf(b));
        case 'count_asc':  return countOf(a) - countOf(b) || titleOf(a).localeCompare(titleOf(b));
        case 'manual':     return a._maclIndex - b._maclIndex;
        default:           return titleOf(a).localeCompare(titleOf(b), undefined, {sensitivity:'base'});
      }
    });
    var frag = document.createDocumentFragment();
    sorted.forEach(function(el){ frag.appendChild(el); });
    grid.appendChild(frag);
  }

  function apply(){
    var q = state.q.toLowerCase();
    var visible = 0;
    items.forEach(function(el){
      var okQ = !q || titleOf(el).toLowerCase().indexOf(q) !== -1;
      var okL = state.letter === ALL || firstLetter(el) === state.letter;
      var show = okQ && okL;
      el.classList.toggle('is-hidden', !show);
      if (show) visible++;
    });
    root.classList.toggle('is-empty', visible === 0);
    if (countEl) {
      countEl.textContent = visible + (visible === 1 ? ' {{ s.count_singular | escape }}' : ' {{ s.count_plural | escape }}');
    }
  }

  var t;
  if (searchEl) {
    searchEl.addEventListener('input', function(){
      clearTimeout(t);
      t = setTimeout(function(){ state.q = searchEl.value; apply(); }, 120);
    });
  }
  if (sortEl) {
    sortEl.value = state.sort;
    sortEl.addEventListener('change', function(){ state.sort = sortEl.value; sortItems(); });
  }

  buildAlpha();
  sortItems();
  apply();
})();
</script>
{%- endif -%}

