{%- comment -%}
  Product grid, used for "Hot deals". Design reference: Main.dc.html (HOT DEALS).
  Sale items (compare-at above price) are listed first, as in the design.
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection
  if source == blank or source.products_count == 0
    assign source = collections['deals']
  endif
  if source == blank or source.products_count == 0
    assign source = collections['all']
  endif
  assign limit = section.settings.limit
  assign shown = 0
  assign link_url = section.settings.link_url | default: source.url
-%}
<section class="ma-products-sec ma-sec--56">
  <div class="ma-wrap">
    <div class="ma-section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="ma-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        <h2 class="ma-h2">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="ma-section-head__link" href="{{ link_url }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="ma-pgrid">
      {%- if section.settings.sale_first -%}
        {%- for product in source.products limit: 50 -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
          {%- if product.compare_at_price > product.price -%}
            {%- render 'ma-product-card', product: product, image_bg: section.settings.image_bg -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for product in source.products limit: 50 -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
          {%- unless product.compare_at_price > product.price -%}
            {%- render 'ma-product-card', product: product, image_bg: section.settings.image_bg -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        {%- for product in source.products limit: limit -%}
          {%- render 'ma-product-card', product: product, image_bg: section.settings.image_bg -%}
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if shown == 0 -%}
        <p class="ma-note">Pick a collection for this section in the theme editor.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Metro product grid",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Hot deals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Essential performance parts" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Empty uses /collections/deals if it exists, otherwise all products." },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 16, "step": 4, "default": 8 },
    { "type": "checkbox", "id": "sale_first", "label": "Show sale items first", "default": true },
    { "type": "select", "id": "image_bg", "label": "Card image background", "default": "auto", "options": [
      { "value": "auto", "label": "White behind photos, dark otherwise" },
      { "value": "dark", "label": "Always dark (design)" },
      { "value": "light", "label": "Always white" }
    ] },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all deals" },
    { "type": "url", "id": "link_url", "label": "Link", "info": "Defaults to the collection." }
  ],
  "presets": [{ "name": "Metro product grid" }]
}
{% endschema %}
