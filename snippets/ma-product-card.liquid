{%- comment -%}
  Metro Auto product card. Design reference: _design/metro-auto-design/components/ProductCard.dc.html

  Usage: {% render 'ma-product-card', product: product %}
  Optional: priority: true for cards in the first visible row (image loads first instead of lazily),
            image_bg: 'auto' (default: white behind photos, dark design panel behind placeholder art),
            'dark' or 'light' to force one,
            sizes: image sizes attribute.

  - Stock line from variant.inventory_quantity: "In stock, N available" / "Only N left" (5 or fewer) / "Out of stock".
  - Fitment tags (make-model-year, e.g. toyota-corolla-2019) are written to data-ma-fit; the fit badge
    is filled in by ma-theme.js against the shopper's garage. A "universal" tag gives "Suits any vehicle".
  - Add to cart posts to /cart/add.js (ma-theme.js).
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign price = variant.price | default: product.price
  assign compare = variant.compare_at_price | default: 0

  assign on_sale = false
  if compare > price
    assign on_sale = true
    assign save = compare | minus: price | times: 100.0 | divided_by: compare | round
  endif

  assign tracked = false
  if variant.inventory_management == 'shopify'
    assign tracked = true
  endif
  assign on_hand = variant.inventory_quantity | default: 0
  assign out = false
  unless variant.available
    assign out = true
  endunless
  assign max = 99
  if tracked and variant.inventory_policy == 'deny' and on_hand > 0
    assign max = on_hand | at_most: 99
  endif

  if out
    assign stock_label = 'Out of stock'
    assign stock_mod = 'out'
  elsif tracked and on_hand > 0 and on_hand <= 5
    assign stock_label = 'Only ' | append: on_hand | append: ' left'
    assign stock_mod = 'low'
  elsif tracked and on_hand > 0
    assign stock_label = 'In stock, ' | append: on_hand | append: ' available'
    assign stock_mod = 'in'
  else
    assign stock_label = 'In stock'
    assign stock_mod = 'in'
  endif

  # Fitment keys from tags, the description's "Compatible Vehicles" list and the custom.fitment metafield.
  capture fit_tags
    render 'ma-fit-keys', product: product
  endcapture
  assign fit_tags = fit_tags | strip
  assign universal = false
  for tag in product.tags
    assign t = tag | handleize
    if t == 'universal'
      assign universal = true
      break
    endif
  endfor

  assign type_label = product.type
  if type_label == blank and product.collections.size > 0
    assign type_label = product.collections.first.title
  endif

  assign img_sizes = sizes | default: '(min-width: 1320px) 300px, (min-width: 1100px) 23vw, (min-width: 640px) 31vw, 48vw'
-%}
<article
  class="ma-pc ma-body{% if out %} ma-pc--out{% endif %}"
  data-ma-card
  data-product-id="{{ product.id }}"
  data-variant-id="{{ variant.id }}"
  data-max="{{ max }}"
  data-ma-fit="{{ fit_tags }}"
  {% if universal %}data-ma-universal{% endif %}
>
  {%- liquid
    # Real photos are shot on white, so they get a white image area; the dark panel is for the placeholder art.
    assign light_media = false
    if image_bg == 'light'
      assign light_media = true
    elsif image_bg != 'dark' and product.featured_media
      assign light_media = true
    endif
  -%}
  <a href="{{ product.url }}" class="ma-pc__media{% if light_media %} ma-pc__media--light{% endif %}" aria-label="{{ product.title | escape }}" tabindex="-1">
    {%- if product.featured_media -%}
      {%- comment -%} Work out alt first: a filter inside a filter argument ends the image_tag call and drops "class". {%- endcomment -%}
      {%- assign img_alt = product.featured_media.alt | default: product.title -%}
      {%- comment -%} First row of a grid (priority: true) loads straight away; the rest load as they scroll in. {%- endcomment -%}
      {%- liquid
        assign img_loading = 'lazy'
        assign img_priority = 'auto'
        if priority
          assign img_loading = 'eager'
          assign img_priority = 'high'
        endif
      -%}
      {{- product.featured_media | image_url: width: 600 | image_tag:
        widths: '200,300,400,600',
        sizes: img_sizes,
        loading: img_loading,
        fetchpriority: img_priority,
        decoding: 'async',
        alt: img_alt,
        class: 'ma-pc__img'
      -}}
    {%- else -%}
      {%- render 'ma-no-image', class: 'ma-pc__img', alt: product.title, eager: priority -%}
    {%- endif -%}
    {%- if on_sale -%}
      <span class="ma-pc__sale">{{ save }}% off</span>
    {%- endif -%}
  </a>

  <button type="button" class="ma-pc__wish" aria-label="Save to wishlist" aria-pressed="false" data-ma-wish="{{ product.handle }}" button-wishlist data-product-handle="{{ product.handle }}">
    {%- render 'ma-icon', name: 'heart', size: 20 -%}
  </button>

  <div class="ma-pc__body">
    <div class="ma-pc__row">
      <span class="ma-pc__stock ma-pc__stock--{{ stock_mod }}">{{ stock_label }}</span>
      {%- if variant.sku != blank -%}<span class="ma-pc__sku">{{ variant.sku | escape }}</span>{%- endif -%}
    </div>
    {%- if type_label != blank -%}
      <span class="ma-pc__type">{{ type_label | escape }}</span>
    {%- endif -%}
    {%- liquid
      # title only: drop a trailing " - Vendor" (e.g. "Oil Dipstick - Toyota 917-392 - Goss")
      assign card_title = product.title | strip
      assign vendor_tail = ' - ' | append: product.vendor
      assign tail_size = vendor_tail.size
      assign tail_from = 0 | minus: tail_size
      assign title_tail = card_title | slice: tail_from, tail_size
      if product.vendor != blank and title_tail == vendor_tail
        assign card_title = card_title | remove_last: vendor_tail | strip
      endif
    -%}
    <a href="{{ product.url }}" class="ma-pc__title">{{ card_title | escape }}</a>
    <span class="ma-pc__fit" data-ma-fit-badge hidden>
      {%- render 'ma-icon', name: 'check', size: 12, width: 3 -%}<span data-ma-fit-text></span>
    </span>
    <div class="ma-pc__prices">
      <span class="ma-pc__price">{{ price | money }}</span>
      {%- if on_sale -%}
        <span class="ma-pc__compare"><span class="ma-sr">Was </span>{{ compare | money }}</span>
      {%- endif -%}
    </div>
    <div class="ma-pc__buy">
      {%- if product.has_only_default_variant == false and out == false -%}
        {%- comment -%} Several variants: send the shopper to the product page to pick one. {%- endcomment -%}
        <a href="{{ product.url }}" class="ma-pc__atc ma-pc__atc--link">Choose options</a>
      {%- else -%}
      <div class="ma-pc-qty">
        <button type="button" aria-label="Decrease quantity" data-ma-qty="-1"{% if out %} disabled{% endif %}>&minus;</button>
        <input type="number" aria-label="Quantity" inputmode="numeric" min="1" max="{{ max }}" value="1" data-ma-qty-input{% if out %} disabled{% endif %}>
        <button type="button" aria-label="Increase quantity" data-ma-qty="1"{% if out %} disabled{% endif %}>+</button>
      </div>
      <button type="button" class="ma-pc__atc" data-ma-atc{% if out %} disabled aria-disabled="true"{% endif %}>
        {%- render 'ma-icon', name: 'cart-small', size: 16, width: 2.2 -%}<span data-ma-atc-label>{% if out %}Out of stock{% else %}Add to cart{% endif %}</span>
      </button>
      {%- endif -%}
    </div>
  </div>
</article>
