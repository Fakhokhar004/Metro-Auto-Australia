    when 'clock'
      assign d = 'M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0'
    when 'filter'
      assign d = 'M4 5h16l-6 8v5l-4 2v-7z'
    when 'chevron'
      assign d = 'M9 6l6 6-6 6'
    when 'rotor'
      assign d = 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z'
    when 'kit'
