      assign d = 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-3.5-3.5'
    when 'car'
      assign d = 'M5 16l1.5-5A2 2 0 0 1 8.4 9.5h7.2a2 2 0 0 1 1.9 1.5L19 16M4.5 16h15a1.5 1.5 0 0 1 1.5 1.5v1a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5v-1A1.5 1.5 0 0 1 4.5 16z'
    when 'heart'
      assign d = 'M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z'
    when 'cart'
      assign d = 'M3 4h2l2.4 11h10.2L20 8H6.2M9 18.6a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8zM17 18.6a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8z'
    when 'cart-small'
