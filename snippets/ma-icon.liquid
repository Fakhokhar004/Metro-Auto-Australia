<svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="{{ c }}" stroke-width="{{ w }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="{{ d }}"></path></svg>
