{%- comment -%}
  Line icons from the Metro Auto design.
  Usage: {% render 'ma-icon', name: 'truck', size: 22, stroke: '#FFFFFF', width: 1.8 %}
  stroke defaults to currentColor.
{%- endcomment -%}
{%- liquid
